<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
<?ifdef NativeMsiUi ?>
  <?foreach WIXUIARCH in X86;X64;A64 ?>
  <Fragment>
    <UI Id="BlueLink_Msi_$(WIXUIARCH)">
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(WIXUIARCH)" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_$(WIXUIARCH)" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
    </UI>
    <UIRef Id="BlueLink_Msi" />
  </Fragment>
  <?endforeach?>
  <Fragment>
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)..\..\design\brand\installer\msi-sidebar.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)..\..\design\brand\installer\msi-banner.bmp" />
    <!-- Keep MSI's native wizard controls and navigation. EXE uses WPF. -->
    <UI Id="BlueLink_Msi">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="BlueLinkOptionsDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="BlueLinkOptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBlueLinkAfterInstall" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX=1 AND NOT Installed AND NOT REMOVE~=&quot;ALL&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Dialog Id="BlueLinkOptionsDlg" Width="370" Height="270" Title="[ProductName] 安装向导">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.VerifyReadyDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}安装选项" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="310" Height="18" Transparent="yes" NoPrefix="yes" Text="确认运行环境与快捷方式设置。" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="RuntimeLabel" Type="Text" X="20" Y="62" Width="330" Height="16" Text="{\WixUI_Font_Title}运行环境" />
        <Control Id="BundledRuntime" Type="Text" X="20" Y="84" Width="330" Height="36" Hidden="yes" Text="此安装包已内置 .NET 8 桌面运行时，无需另外安装。" ShowCondition="BLUELINK_BUNDLED_RUNTIME=1" />
        <Control Id="ExternalRuntime" Type="Text" X="20" Y="84" Width="330" Height="36" Hidden="yes" Text="已检测到匹配架构的 .NET 8 桌面运行时，可以继续安装。" ShowCondition="BLUELINK_BUNDLED_RUNTIME&lt;&gt;1 AND BLUELINK_DOTNET_CHECK=&quot;0&quot;" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="132" Width="330" Height="20" Property="CREATE_DESKTOP_SHORTCUT" CheckBoxValue="1" Text="在桌面创建蓝联快捷方式" />
        <Control Id="DataNotice" Type="Text" X="20" Y="173" Width="330" Height="38" Text="安装和修复会保留聊天记录、已信任设备、设置与已接收文件。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)"><Publish Event="NewDialog" Value="VerifyReadyDlg" /></Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)"><Publish Event="SpawnDialog" Value="CancelDlg" /></Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
<?endif ?>
</Wix>
