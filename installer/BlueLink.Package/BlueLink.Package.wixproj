<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>true</SuppressValidation>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <LauncherExe Condition="'$(LauncherExe)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\win-x64\BlueLink.exe</LauncherExe>
    <LauncherConfig Condition="'$(LauncherConfig)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\win-x64\BlueLink.exe.config</LauncherConfig>
    <UninstallExe Condition="'$(UninstallExe)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\win-x64\Uninstall.exe</UninstallExe>
    <UninstallConfig Condition="'$(UninstallConfig)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\win-x64\Uninstall.exe.config</UninstallConfig>
    <ManifestPath Condition="'$(ManifestPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\win-x64\.bluelink-install.json</ManifestPath>
    <ProductName Condition="'$(ProductName)' == ''">钃濊仈 BlueLink</ProductName>
    <ProductCode Condition="'$(ProductCode)' == ''">*</ProductCode>
    <PackageUpgradeCode Condition="'$(PackageUpgradeCode)' == ''">{BE8A6A43-710C-4B6E-92DC-07C4FAFC22B9}</PackageUpgradeCode>
    <BundleUpgradeCode Condition="'$(BundleUpgradeCode)' == ''">{6B6EB4AB-16E2-4E54-BBBE-556061F7D4A7}</BundleUpgradeCode>
    <BundleProviderKey Condition="'$(BundleProviderKey)' == ''">BlueLink.Desktop.Bundle.$(ProductVersion)</BundleProviderKey>
    <ApplicationComponentGuid Condition="'$(ApplicationComponentGuid)' == ''">{565A25F4-074D-4E8C-A74A-5236B82557D5}</ApplicationComponentGuid>
    <UninstallerComponentGuid Condition="'$(UninstallerComponentGuid)' == ''">{0D44C7C9-E2EA-4C98-A354-C9F35AA9E739}</UninstallerComponentGuid>
    <ManifestComponentGuid Condition="'$(ManifestComponentGuid)' == ''">{1D4090E6-9FBF-49B2-8B3A-45D93705AF7E}</ManifestComponentGuid>
    <DownloadComponentGuid Condition="'$(DownloadComponentGuid)' == ''">{928C940E-4588-4279-88D4-BDCE8A21840E}</DownloadComponentGuid>
    <StartMenuComponentGuid Condition="'$(StartMenuComponentGuid)' == ''">{BA52F0DC-8D97-4DE6-A745-A1140E92F609}</StartMenuComponentGuid>
    <DesktopComponentGuid Condition="'$(DesktopComponentGuid)' == ''">{08F15234-6364-4F40-B5ED-C74F64C0806B}</DesktopComponentGuid>
    <AutoStartComponentGuid Condition="'$(AutoStartComponentGuid)' == ''">{9FD0E1E0-913C-4906-A026-625313D0E250}</AutoStartComponentGuid>
    <ProductRegistryKey Condition="'$(ProductRegistryKey)' == ''">Software\BlueLink</ProductRegistryKey>
    <StartMenuComponentCondition Condition="'$(StartMenuComponentCondition)' == ''">1</StartMenuComponentCondition>
    <MajorUpgradeSchedule Condition="'$(MajorUpgradeSchedule)' == ''">afterInstallExecute</MajorUpgradeSchedule>
    <AllowSameVersionUpgrades Condition="'$(AllowSameVersionUpgrades)' == ''">no</AllowSameVersionUpgrades>
    <DefineConstants>MajorUpgradeSchedule=$(MajorUpgradeSchedule);AllowSameVersionUpgrades=$(AllowSameVersionUpgrades);ProductVersion=$(ProductVersion);LauncherExe=$(LauncherExe);LauncherConfig=$(LauncherConfig);UninstallExe=$(UninstallExe);UninstallConfig=$(UninstallConfig);ManifestPath=$(ManifestPath);ProductName=$(ProductName);ProductCode=$(ProductCode);PackageUpgradeCode=$(PackageUpgradeCode);BundleUpgradeCode=$(BundleUpgradeCode);BundleProviderKey=$(BundleProviderKey);ApplicationComponentGuid=$(ApplicationComponentGuid);UninstallerComponentGuid=$(UninstallerComponentGuid);ManifestComponentGuid=$(ManifestComponentGuid);DownloadComponentGuid=$(DownloadComponentGuid);StartMenuComponentGuid=$(StartMenuComponentGuid);DesktopComponentGuid=$(DesktopComponentGuid);AutoStartComponentGuid=$(AutoStartComponentGuid);ProductRegistryKey=$(ProductRegistryKey);StartMenuComponentCondition=$(StartMenuComponentCondition)</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GeneratedPayloadPath)' != ''">
    <Compile Remove="Package.Generated.wxs" />
    <Compile Include="$(GeneratedPayloadPath)" />
  </ItemGroup>
  <Target Name="UseReviewPayload" BeforeTargets="CoreCompile" Condition="'$(GeneratedPayloadPath)' != ''">
    <ItemGroup><Compile Remove="Package.Generated.wxs" /></ItemGroup>
  </Target>
</Project>
