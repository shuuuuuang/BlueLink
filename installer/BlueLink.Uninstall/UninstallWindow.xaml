<ui:FluentWindow x:Class="BlueLink.Uninstall.UninstallWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:install="clr-namespace:BlueLink.Installation"
 Title="蓝联卸载向导" Width="1040" Height="680" MinWidth="920" MinHeight="620" FontFamily="{DynamicResource InstallerFont}"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" Background="#FBFCFF" UseLayoutRounding="True">
  <ui:FluentWindow.Resources>
    <FontFamily x:Key="InstallerFont">pack://application:,,,/Uninstall;component/Assets/Fonts/#Noto Sans SC</FontFamily>
    <BitmapImage x:Key="InstallerLogo" UriSource="pack://application:,,,/Uninstall;component/Assets/bluelink-logo.png"/>
    <BitmapImage x:Key="InstallerFolder" UriSource="pack://application:,,,/Uninstall;component/Assets/Installer/folder.png"/>
    <BitmapImage x:Key="InstallerDownload" UriSource="pack://application:,,,/Uninstall;component/Assets/Installer/runtime-download.png"/>
    <BitmapImage x:Key="InstallerWarning" UriSource="pack://application:,,,/Uninstall;component/Assets/Installer/warning.png"/>
    <BitmapImage x:Key="InstallerSuccess" UriSource="pack://application:,,,/Uninstall;component/Assets/Installer/success.png"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource InstallerFont}"/><Setter Property="Foreground" Value="#101B39"/></Style>
    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="20,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  </ui:FluentWindow.Resources>
 <Grid Background="#FBFCFF"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
  <ui:TitleBar Title="蓝联卸载向导" ShowMinimize="True" ShowMaximize="True"><ui:TitleBar.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource InstallerLogo}" Width="30" Height="30"/><TextBlock Text="蓝联卸载向导" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></ui:TitleBar.Header></ui:TitleBar>
  <install:UninstallView x:Name="UninstallSurface" Grid.Row="1"/>
  <Border x:Name="DialogOverlay" Grid.Row="1" Background="#660B1220" Visibility="Collapsed" Panel.ZIndex="90"/>
 </Grid>
</ui:FluentWindow>
