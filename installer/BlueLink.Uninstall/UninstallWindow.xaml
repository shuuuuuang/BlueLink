<ui:FluentWindow x:Class="BlueLink.Uninstall.UninstallWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="卸载蓝联" Width="760" Height="520" MinWidth="680" MinHeight="480"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="#FBFCFF">
  <ui:FluentWindow.Resources>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#101B39"/></Style>
    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="20,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  </ui:FluentWindow.Resources>
  <Grid Background="#FBFCFF">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
    <ui:TitleBar Title="卸载蓝联" ShowMinimize="True" ShowMaximize="False" ShowClose="True">
      <ui:TitleBar.Header><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Uninstall;component/Assets/bluelink-logo.png" Width="30" Height="30"/><TextBlock Text="蓝联卸载程序" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></ui:TitleBar.Header>
    </ui:TitleBar>
    <StackPanel Grid.Row="1" Margin="54,42,54,20">
      <TextBlock Text="卸载蓝联" FontSize="32" FontWeight="Bold"/>
      <TextBlock Text="将从此电脑删除蓝联程序。" FontSize="16" Foreground="#58698D" Margin="0,10,0,24"/>
      <Border Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="14" Padding="22,18">
        <StackPanel>
          <TextBlock Text="将删除" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="程序文件、开始菜单和桌面快捷方式、自启动项" Foreground="#58698D" Margin="0,7,0,16"/>
          <TextBlock Text="将保留" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="聊天记录、蓝联设置，以及 Download 中已经接收的文件" Foreground="#58698D" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
      <ui:InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" Margin="0,18,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="#D8E0EC" BorderThickness="0,1,0,0" Padding="54,24">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button x:Name="CancelButton" Content="取消" Appearance="Secondary" Width="118" Margin="0,0,14,0" Click="Cancel_Click"/><ui:Button x:Name="RemoveButton" Content="卸载" Appearance="Danger" Width="128" Click="Remove_Click"/></StackPanel>
    </Border>
    <Border x:Name="DialogOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#660B1220" Visibility="Collapsed" Panel.ZIndex="90"/>
  </Grid>
</ui:FluentWindow>
