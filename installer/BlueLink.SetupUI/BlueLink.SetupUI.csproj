<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BlueLink.SetupUI</AssemblyName>
    <RootNamespace>BlueLink.SetupUI</RootNamespace>
    <ApplicationIcon>..\..\design\brand\app-icons\windows\bluelink.ico</ApplicationIcon>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WixToolset.Mba.Core" Version="4.0.6" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\InstallDirectoryOwnership.cs" Link="Shared\InstallDirectoryOwnership.cs" />
    <Compile Include="..\..\shared\InstallerExecutionPolicy.cs" Link="Shared\InstallerExecutionPolicy.cs" />
    <Compile Include="..\..\shared\WindowsAppControlChannel.cs" Link="Shared\WindowsAppControlChannel.cs" />
    <Compile Include="..\..\shared\InstalledApplicationController.cs" Link="Shared\InstalledApplicationController.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\design\brand\final\bluelink-final-logo.png">
      <Link>Assets\bluelink-logo.png</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="BlueLink.SetupUI.BootstrapperCore.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\SharedUI\Assets\*.png" Link="Assets\Installer\%(Filename)%(Extension)" />
    <Resource Include="..\..\windows\BlueLink.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedUI\InstallerConfirmationDialog.cs" Link="InstallerConfirmationDialog.cs" />
    <Compile Include="..\SharedUI\InstallerNoticeWindow.cs" Link="InstallerNoticeWindow.cs" />
    <Page Include="..\SharedUI\UninstallView.xaml" Link="UninstallView.xaml" />
    <Compile Include="..\SharedUI\UninstallView.xaml.cs" Link="UninstallView.xaml.cs" />
    <Compile Include="..\..\shared\UserDataCleanup.cs" Link="Shared\UserDataCleanup.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\shared\WindowsDialogLayout.cs" Link="Shared\WindowsDialogLayout.cs" /></ItemGroup>
</Project>
