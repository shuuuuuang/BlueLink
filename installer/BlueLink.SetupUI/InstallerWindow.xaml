<ui:FluentWindow x:Class="BlueLink.SetupUI.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:install="clr-namespace:BlueLink.Installation"
        Title="蓝联安装向导" Width="800" Height="560" MinWidth="800" MinHeight="560" MaxWidth="800" MaxHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Style="{StaticResource {x:Type ui:FluentWindow}}"
        Background="#FBFCFF" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
    <FontFamily x:Key="InstallerFont">pack://application:,,,/BlueLink.SetupUI;component/Assets/Fonts/#Noto Sans SC</FontFamily>
    <BitmapImage x:Key="InstallerLogo" UriSource="pack://application:,,,/BlueLink.SetupUI;component/Assets/bluelink-logo.png"/>
    <BitmapImage x:Key="InstallerFolder" UriSource="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/folder.png"/>
    <BitmapImage x:Key="InstallerDownload" UriSource="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/runtime-download.png"/>
    <BitmapImage x:Key="InstallerWarning" UriSource="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/warning.png"/>
    <BitmapImage x:Key="InstallerSuccess" UriSource="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/success.png"/>
        <SolidColorBrush x:Key="Ink" Color="#101B39" />
        <SolidColorBrush x:Key="Muted" Color="#58698D" />
        <SolidColorBrush x:Key="Primary" Color="#1264F6" />
        <SolidColorBrush x:Key="Panel" Color="#F5F8FE" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InstallerFont}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Primary" /><Setter Property="Background" Value="#1264F6"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource InstallerFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Resources><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1264F6" Opacity="0.5"/><SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/><SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White"/></Style.Resources>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Appearance" Value="Secondary" /><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#101B39"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontFamily" Value="{StaticResource InstallerFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource InstallerFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Border x:Name="WindowSurface" Background="#FBFCFF">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrandColumn" Width="297" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:TitleBar x:Name="InstallerTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Title="蓝联安装向导"
                         ShowMaximize="False" ShowMinimize="True" ShowClose="True" Panel.ZIndex="12">
                <ui:TitleBar.Header>
                    <StackPanel x:Name="HeaderBrand" Orientation="Horizontal" Margin="-10,0,0,0">
                        <Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/bluelink-logo.png" Width="22" Height="22" Stretch="Uniform" />
                        <TextBlock x:Name="HeaderCaption" Text="蓝联安装向导" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>
            <Border x:Name="BrandPanel" Grid.Row="1" Grid.Column="0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#082D95" Offset="0" /><GradientStop Color="#075DDF" Offset="0.48" /><GradientStop Color="#031F73" Offset="1" /></LinearGradientBrush></Border.Background>
                <Grid ClipToBounds="True">
                    <Ellipse Width="420" Height="420" Fill="#0C52C8" Opacity="0.55" Margin="-195,-210,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="390" Height="390" Fill="#062066" Opacity="0.58" Margin="0,0,-232,-188" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    <StackPanel x:Name="BrandContentStack" Margin="30,32,22,28">
                        <StackPanel x:Name="PanelBrandHeader" Orientation="Horizontal"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/bluelink-logo.png" Width="39" Height="39" Stretch="Uniform" /><TextBlock Text="蓝联安装向导" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        <Image x:Name="BrandHeroLogo" Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/bluelink-logo.png" Width="248" Height="248" Stretch="Uniform" Margin="-6,26,0,11" />
                        <TextBlock x:Name="BrandName" Text="蓝联" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="BrandTagline" Text="BLUETOOTH · USB" Foreground="#BED7FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentShell" Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="InstallerBodyScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,12"><Grid>
                    <Grid x:Name="WelcomePage">
                        <StackPanel VerticalAlignment="Top" Margin="0,13,0,0">
                            <TextBlock Text="欢迎安装蓝联" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="在 Android 与 Windows 之间，安全地聊天和传输文件。" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,14" />
                            <Grid Margin="0,0,0,3">
                                <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="82" /><RowDefinition Height="82" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="#EDF3FF" CornerRadius="13" VerticalAlignment="Top"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/bluetooth.png" Width="22" Height="22"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0"><TextBlock Text="蓝牙与 USB 直连" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="消息和文件通过设备直连传输，无需网络。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#DDE4EF" VerticalAlignment="Top" Margin="0,-8,0,0" />
                                <Border Grid.Row="1" Width="44" Height="44" Background="#EDF3FF" CornerRadius="13" VerticalAlignment="Top"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/lock.png" Width="22" Height="22"/></Border>
                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0"><TextBlock Text="端到端加密" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="消息与文件在设备间加密，确保隐私安全。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="#DDE4EF" VerticalAlignment="Top" Margin="0,-8,0,0" />
                                <Border Grid.Row="2" Width="44" Height="44" Background="#EDF3FF" CornerRadius="13" VerticalAlignment="Top"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/laptop.png" Width="22" Height="22"/></Border>
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0"><TextBlock Text="支持多设备会话" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="同时管理多个设备的会话与文件传输。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LocationPage" Visibility="Collapsed">
                        <StackPanel Margin="0,30,0,0">
                            <TextBlock Text="选择安装位置" FontSize="26" FontWeight="Bold" /><TextBlock Text="请选择蓝联的安装文件夹。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,18" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions><ui:TextBox x:Name="InstallFolderBox" FontSize="13" Height="32" /><ui:Button Grid.Column="1" Width="94" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Browse_Click" /></Grid>
                            <TextBlock x:Name="LocationErrorText" Foreground="#F04444" FontSize="12" TextWrapping="Wrap" MinHeight="18" Margin="2,0,0,0" />
                            <StackPanel Margin="2,2,0,0"><TextBlock x:Name="RequiredSpaceText" Text="预留空间 256 MiB" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="AvailableSpaceText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" /></StackPanel>
                            <Border Background="#F5F7FE" BorderBrush="#D9E1EF" BorderThickness="1" CornerRadius="13" Height="96" Padding="16,14" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="69" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/folder.png" Width="52" Height="50" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="默认接收文件夹" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="&lt;安装位置&gt;\Download" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /><TextBlock x:Name="FallbackFolderText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel></Grid></Border>

                        </StackPanel>
                    </Grid>

                    <Grid x:Name="RuntimePage" Visibility="Collapsed"><StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="RuntimeHeading" Text="需要安装 .NET 8 桌面运行时" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="RuntimeDescription" Text="蓝联需要此运行环境才能正常启动。安装向导可以为你自动下载并安装。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
                        <Border MinHeight="117" Margin="0,21,0,0" Background="White" BorderBrush="#CBD6E8" BorderThickness="1" CornerRadius="11" Padding="21,14,21,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="69" Height="69" CornerRadius="46" Background="#E7EFFF" HorizontalAlignment="Left"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/runtime-download.png" Width="39" Height="39"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="Microsoft .NET Desktop Runtime 8" FontSize="18" FontWeight="Bold" LineHeight="26" LineStackingStrategy="BlockLineHeight"/>
                                    <Border x:Name="RuntimeStatusBorder" Background="#FFF0E4" CornerRadius="6" Padding="8,3" MinWidth="106" HorizontalAlignment="Left" Margin="0,3,0,0"><TextBlock x:Name="RuntimeStatusBadge" Text="尚未安装" Foreground="#DA7218" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"/></Border>
                                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RuntimeArchitectureText" Text="架构：x64" FontSize="13" Foreground="{StaticResource Muted}"/>
                                        <Border Grid.Column="1" Background="#D9E1EE"/><TextBlock x:Name="RuntimePackageSizeText" Grid.Column="2" FontSize="13" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
                                        <Border Grid.Column="3" Background="#D9E1EE"/><TextBlock Grid.Column="4" Text="来源：Microsoft 官方" FontSize="13" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
                                    </Grid><ProgressBar Foreground="#1264F6" Background="#DCE5F4" x:Name="RuntimeDownloadProgress" Height="8" BorderThickness="0" Visibility="Collapsed" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ui:InfoBar x:Name="RuntimeInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" MinHeight="32" Message="仅安装运行环境，不会更改你的聊天记录、接收文件或蓝联设置。" Margin="0,16,0,0"/>
                        <TextBlock x:Name="RuntimeStageNote" FontSize="12" Foreground="{StaticResource Primary}" Margin="0,14,0,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="RuntimeLinks" Orientation="Horizontal" Margin="0,14,0,0"><ui:Button Appearance="Transparent" Padding="0" Height="Auto" MinHeight="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Click="RuntimeRedetect_Click"><TextBlock Text="我已安装，重新检测" Foreground="#0969F5"/></ui:Button><ui:Button x:Name="RuntimeOfficialDownloadButton" Content="Microsoft 官方手动下载" Appearance="Transparent" Foreground="#0969F5" Padding="0" Margin="18,0,0,0" Visibility="Collapsed" Click="RuntimeOfficialDownload_Click"/></StackPanel>
                    </StackPanel></Grid>

                    <Grid x:Name="ProgressPage" Visibility="Collapsed">
                        <StackPanel Margin="0,32,0,0">
                            <TextBlock Text="正在安装蓝联" FontSize="26" FontWeight="Bold"/><TextBlock Text="请稍候，安装向导正在将蓝联安装到您的电脑。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,18"/>
                            <Border Background="#F8FAFF" BorderBrush="#CDD8EB" BorderThickness="1" CornerRadius="12" Padding="16,12,16,16"><StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock x:Name="ProgressStatusText" Text="正在复制应用文件…" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/><TextBlock x:Name="ProgressPercentageText" Grid.Column="1" Text="0%" FontSize="20" Foreground="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
                                <ProgressBar Foreground="#1264F6" Background="#DCE5F4" x:Name="InstallProgressBar" Height="10" BorderThickness="0" Minimum="0" Maximum="100" Margin="0,10,0,16"/>
                                <Border Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="8" MinHeight="51" Padding="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/folder.png" Width="18" Height="18" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProgressFolderText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
                                <TextBlock x:Name="StagePercentText" Visibility="Collapsed"/>
                            </StackPanel></Border>
                            <TextBlock Text="ⓘ  安装完成后将创建默认接收文件夹 Download" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,22,0,0"/><TextBlock Text="安装期间请勿关闭安装向导。" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CompletePage" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource InstallerSuccess}" Width="57" Height="57"/><TextBlock x:Name="CompleteTitleText" Text="蓝联安装完成" FontSize="26" FontWeight="Bold" Margin="18,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            <TextBlock Text="现在可以通过蓝牙或 USB 与附近设备安全聊天和传输文件。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,13,0,16" /><Border Height="1" Background="#DDE4EF" />
                            <Grid Margin="0,14,0,6">
                                <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="CompleteInstallIconBackground" Grid.Row="0" Width="36" Height="36" Background="#E4EBFF" CornerRadius="10">
                                    <TextBlock x:Name="CompleteInstallIcon" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#718CEB" FontSize="18" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="安装位置" FontSize="12" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CompleteInstallPathText" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ui:Button x:Name="CompleteInstallCopyButton" Grid.Column="1" Width="24" Height="24" Margin="8,0,0,0" Content="&#xE8C8;" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Primary}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="复制安装位置" AutomationProperties.Name="复制安装位置" Click="CopyInstallPath_Click" />
                                    </Grid>
                                </Grid>
                                <Border x:Name="CompleteDownloadIconBackground" Grid.Row="1" Width="36" Height="36" Background="#E4EBFF" CornerRadius="10">
                                    <TextBlock x:Name="CompleteDownloadIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#718CEB" FontSize="18" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="默认接收文件夹" FontSize="12" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CompleteDownloadPathText" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ui:Button x:Name="CompleteDownloadCopyButton" Grid.Column="1" Width="24" Height="24" Margin="8,0,0,0" Content="&#xE8C8;" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Primary}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="复制接收目录" AutomationProperties.Name="复制接收目录" Click="CopyDownloadPath_Click" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Border Height="1" Background="#DDE4EF" Margin="0,2,0,9" /><CheckBox x:Name="LaunchAfterCheckBox" Content="立即启动蓝联" IsChecked="True" /><CheckBox x:Name="DesktopShortcutCheckBox" Content="在桌面创建快捷方式" IsChecked="True" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="UninstallPage" Visibility="Collapsed"/>

                    <Grid x:Name="FailurePage" Visibility="Collapsed"><StackPanel Margin="0,21,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="63"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#FDECEC" CornerRadius="16" HorizontalAlignment="Left"><Image Source="pack://application:,,,/BlueLink.SetupUI;component/Assets/Installer/warning.png" Width="48" Height="48"/></Border><StackPanel Grid.Column="1"><TextBlock Text="安装未完成" FontSize="26" FontWeight="Bold"/><TextBlock Text="蓝联未能完成安装。请根据下方信息处理后重试。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/></StackPanel></Grid>
                        <Border Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="16" Padding="15" MinHeight="142" Margin="0,16,0,0"><StackPanel>
                            <TextBlock Text="错误详情" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="FailureText" FontSize="13" LineHeight="19" Margin="0,6,0,9"/>
                            <Border Height="1" Background="#EEF1F5"/><Grid Margin="0,14,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="安装日志" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FailureLogPathText" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><ui:Button x:Name="FailureLogButton" Grid.Column="1" Content="打开日志文件夹" Appearance="Secondary" Height="26" Padding="8,3" Foreground="{StaticResource Primary}" Click="OpenFailureLog_Click"/></Grid>
                        </StackPanel></Border>
                        <Border Background="#EAF1FF" CornerRadius="16" Padding="15" MinHeight="64" Margin="0,14,0,0"><StackPanel><TextBlock Text="建议先尝试" FontSize="12" FontWeight="Medium"/><TextBlock Text="关闭正在运行的蓝联，并检查磁盘空间与目录权限，然后重新安装。请保留安装日志以便排查。" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18" Margin="0,3,0,0"/></StackPanel></Border>
                    </StackPanel></Grid>
                </Grid></ScrollViewer>

                <Border Grid.Row="1" BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Padding="24,12">
                    <Grid>
                        <TextBlock x:Name="FooterInfoText" Text="版本未知  ·  Windows 10/11 x64" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel x:Name="NavigationButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,9,0" Visibility="Collapsed" Click="Back_Click" /><ui:Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,9,0" Click="Close_Click" /><ui:Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}" Background="#1264F6" BorderBrush="#1264F6" Foreground="White" MinWidth="98" Click="Next_Click" /></StackPanel>
                        <StackPanel x:Name="CompletionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><ui:Button Content="打开接收文件夹" Style="{StaticResource SecondaryButton}" MinWidth="122" Margin="0,0,10,0" Click="OpenDownload_Click" /><ui:Button x:Name="FinishButton" Content="完成" Style="{StaticResource PrimaryButton}" Background="#1264F6" BorderBrush="#1264F6" Foreground="White" MinWidth="104" Click="Finish_Click" /></StackPanel>
                        <StackPanel x:Name="RuntimeButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><ui:Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,10,0" Click="RuntimeCancel_Click"/><ui:Button x:Name="RuntimePrimary" Content="下载并安装" Style="{StaticResource PrimaryButton}" Background="#1264F6" BorderBrush="#1264F6" Foreground="White" MinWidth="110" Click="RuntimeInstall_Click"/></StackPanel>
                        <StackPanel x:Name="UninstallButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><ui:Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,10,0" Click="Close_Click"/><ui:Button Content="卸载" Appearance="Danger" Style="{StaticResource PrimaryButton}" Background="#1264F6" BorderBrush="#1264F6" Foreground="White" MinWidth="98" Click="RemoveApplication_Click"/></StackPanel>
                        <StackPanel x:Name="FailureButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><ui:Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}" MinWidth="82" Margin="0,0,9,0" Click="Close_Click"/><ui:Button Content="重试安装" Style="{StaticResource PrimaryButton}" Background="#1264F6" BorderBrush="#1264F6" Foreground="White" MinWidth="106" Click="RetryInstall_Click"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <install:UninstallView x:Name="UninstallSurface" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"/>
            <Border x:Name="DialogOverlay" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="90"
                    Background="#660B1220" Visibility="Collapsed" IsHitTestVisible="True" />
        </Grid>
    </Border>
</ui:FluentWindow>
