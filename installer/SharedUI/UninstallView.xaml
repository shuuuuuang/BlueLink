<UserControl x:Class="BlueLink.Installation.UninstallView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="#FBFCFF" FontFamily="{DynamicResource InstallerFont}">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#101B39"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="#58698D"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E1EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,18,0,0"/></Style>
  <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="118"/><Setter Property="Padding" Value="20,6"/><Setter Property="FontSize" Value="16"/></Style>
 </UserControl.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="BrandColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="123"/></Grid.RowDefinitions>
  <Border x:Name="BrandPanel" Grid.RowSpan="2" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#082D95" Offset="0"/><GradientStop Color="#075DDF" Offset="0.48"/><GradientStop Color="#031F73" Offset="1"/></LinearGradientBrush></Border.Background><Grid ClipToBounds="True">
   <Ellipse Width="560" Height="560" Fill="#0C52C8" Opacity="0.55" Margin="-260,-280,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/><Ellipse Width="520" Height="520" Fill="#062066" Opacity="0.58" Margin="0,0,-310,-250" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
   <StackPanel><Image x:Name="BrandHeroLogo" Source="{DynamicResource InstallerLogo}" Width="390" Height="390" Margin="-19,80,-19,0"/><TextBlock Text="蓝联" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,0"/>
   <TextBlock Text="BLUETOOTH · USB" Foreground="#BED7FF" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <ScrollViewer x:Name="BodyScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="54,72,54,24">
   <StackPanel>
    <StackPanel Orientation="Horizontal"><Border x:Name="StateIconTile" Width="76" Height="76" Visibility="Collapsed" Margin="0,0,24,0" CornerRadius="16"><Image x:Name="StateIcon"/></Border><TextBlock x:Name="Heading" Text="卸载蓝联" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
    <TextBlock x:Name="DescriptionText" Text="卸载程序前，可以选择是否同时删除本机用户数据。" Style="{StaticResource Description}" FontSize="16" Margin="0,14,0,16"/>
    <StackPanel x:Name="OptionsPanel">
     <Border Style="{StaticResource Card}" Margin="0,16,0,0" MinHeight="100"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="60" Height="60" HorizontalAlignment="Left" Background="#EDF3FF" CornerRadius="13"><ui:SymbolIcon Symbol="Delete24" FontSize="24" Foreground="#536BFF"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="卸载应用" FontSize="17" FontWeight="Medium"/><TextBlock Text="删除程序文件、开始菜单和桌面快捷方式、自启动项。" Style="{StaticResource Description}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
     <Border x:Name="DeleteDataCard" Style="{StaticResource Card}"><StackPanel>
      <CheckBox x:Name="DeleteDataCheck" Content="同时删除用户数据" FontSize="17" IsChecked="False" Checked="DeleteChanged" Unchecked="DeleteChanged"/>
      <TextBlock x:Name="DeleteDescription" Text="删除聊天记录、已信任设备和蓝联设置。" Style="{StaticResource Description}" Margin="36,8,0,0"/>
      <Border Background="#EDF3FF" CornerRadius="8" Padding="12,9" Margin="36,14,0,0"><TextBlock Text="ⓘ  Download 中已接收的文件始终保留。" Foreground="#1264F6" FontSize="13"/></Border>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}" Background="#F8FAFF" Padding="22,16,22,22"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock x:Name="ProgressStatus" FontSize="16" VerticalAlignment="Center"/><TextBlock x:Name="Percent" Grid.Column="1" FontSize="24" Foreground="#1264F6" HorizontalAlignment="Right"/></Grid><ProgressBar Foreground="#1264F6" Background="#DCE5F4" x:Name="Progress" Height="10" BorderThickness="0" IsIndeterminate="True" Margin="0,14,0,22"/>
     <Border Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="8" MinHeight="68" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{DynamicResource InstallerFolder}" Width="24" Height="24" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="卸载位置" Style="{StaticResource Description}" FontSize="12"/><TextBlock x:Name="InstallPath" Style="{StaticResource Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
    </StackPanel></Border><TextBlock Text="ⓘ  Download 中已接收的文件不会被删除" Style="{StaticResource Description}" Margin="0,30,0,0"/><TextBlock Text="卸载期间请勿关闭安装向导。" Style="{StaticResource Description}" Margin="0,16,0,0"/></StackPanel>
    <StackPanel x:Name="CompletePanel" Visibility="Collapsed"><Border BorderBrush="#DDE4EF" BorderThickness="0,1" Margin="0,6,0,20" Padding="0,16"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="70"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <Border Width="48" Height="48" Background="#E4EBFF" CornerRadius="10" HorizontalAlignment="Left"><Image Source="{DynamicResource InstallerFolder}" Width="24" Height="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="已移除内容" FontSize="14" FontWeight="Medium"/><TextBlock Text="程序文件、快捷方式和注册信息" Style="{StaticResource Description}" FontSize="13" Margin="0,6,0,0"/></StackPanel><ui:Button Grid.Column="2" MinWidth="0" Width="34" Padding="4" Appearance="Transparent" Background="Transparent" BorderThickness="0" Click="CopyRemoved_Click" AutomationProperties.Name="复制已移除内容"><ui:SymbolIcon Symbol="Copy20" FontSize="20" Foreground="#1264F6"/></ui:Button>
     <Border Grid.Row="1" Width="48" Height="48" Background="#E4EBFF" CornerRadius="10" HorizontalAlignment="Left"><Image Source="{DynamicResource InstallerDownload}" Width="24" Height="24"/></Border><StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DataOutcome" FontSize="14" FontWeight="Medium"/><TextBlock x:Name="DataDetail" Style="{StaticResource Description}" FontSize="13" Margin="0,6,0,0"/></StackPanel><ui:Button Grid.Row="1" Grid.Column="2" MinWidth="0" Width="34" Padding="4" Appearance="Transparent" Background="Transparent" BorderThickness="0" Click="CopyData_Click" AutomationProperties.Name="复制用户数据处理结果"><ui:SymbolIcon Symbol="Copy20" FontSize="20" Foreground="#1264F6"/></ui:Button>
    </Grid></Border><StackPanel Orientation="Horizontal"><Border Background="#1264F6" CornerRadius="3" Width="20" Height="20"><ui:SymbolIcon Symbol="Checkmark16" FontSize="16" Foreground="White"/></Border><TextBlock x:Name="DataSummary" FontSize="16" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Border Background="#1264F6" CornerRadius="3" Width="20" Height="20"><ui:SymbolIcon Symbol="Checkmark16" FontSize="16" Foreground="White"/></Border><TextBlock Text="Download 中已接收的文件未被删除" FontSize="16" Margin="12,0,0,0"/></StackPanel></StackPanel>
    <StackPanel x:Name="FailurePanel" Visibility="Collapsed"><Border Style="{StaticResource Card}" CornerRadius="16" MinHeight="190"><StackPanel><TextBlock Text="错误详情" FontSize="14" FontWeight="Medium"/><TextBlock x:Name="ErrorText" FontSize="16" Margin="0,10,0,14"/><Border Height="1" Background="#EEF1F5"/><Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="安装日志" Style="{StaticResource Description}" FontSize="12"/><TextBlock x:Name="LogPathText" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><ui:Button x:Name="LogButton" Grid.Column="1" Content="打开日志文件夹" Height="34" FontSize="13" Padding="10,4" Appearance="Secondary" Background="White" Foreground="#1264F6" Click="Log_Click"/></Grid></StackPanel></Border>
     <Border Background="#EAF1FF" CornerRadius="16" Padding="20" MinHeight="86" Margin="0,18,0,0"><StackPanel><TextBlock Text="建议先尝试" FontSize="14" FontWeight="Medium"/><TextBlock x:Name="RecoveryText" Style="{StaticResource Description}" FontSize="13" LineHeight="20" Margin="0,4,0,0"/></StackPanel></Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Grid.Column="1" BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Padding="54,24"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
   <ui:Button x:Name="Secondary" Content="取消" Appearance="Secondary" Background="White" Foreground="#101B39" Margin="0,0,12,0" Click="Secondary_Click"/>
   <ui:Button x:Name="Primary" Content="卸载" Appearance="Danger" MinWidth="130" Click="Primary_Click"/>
  </StackPanel></Border>
 </Grid>
</UserControl>
