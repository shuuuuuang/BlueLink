<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 华为云 NuGet v3 镜像：当前构建环境已实测可访问。 -->
    <add key="huaweicloud" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
    <!-- WPF-UI 与 WiX SDK/扩展启用官方源作为定向回退。 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="huaweicloud">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="WixToolset.*" />
      <package pattern="WPF-UI" />
      <package pattern="WPF-UI.*" />
      <package pattern="System.Memory" />
      <package pattern="System.ValueTuple" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
