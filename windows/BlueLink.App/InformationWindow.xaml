<ui:FluentWindow x:Class="BlueLink.InformationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="520" Height="370" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Title="{Binding Title}" FontFamily="{StaticResource HomeFont}" FontSize="12"
    Background="{DynamicResource SurfaceBrush}" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None" ShowInTaskbar="False" Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InformationBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" FontSize="{StaticResource ClientFont16}" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" Margin="16,10,62,0" VerticalAlignment="Top"/>
                <ui:Button CornerRadius="8" x:Name="InformationCloseButton" Width="32" Height="32" MinWidth="0" MinHeight="0" Margin="0,10,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="6" BorderThickness="0"
                    AutomationProperties.Name="{loc:Text '关闭'}" ToolTip="{loc:Text '关闭'}" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss20" Width="20" Height="20" FontSize="16" Foreground="{DynamicResource MutedBrush}"/>
                </ui:Button>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource InformationDividerBrush}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,16">
                <StackPanel>
                    <Border x:Name="InformationSummary" Height="68" Background="{DynamicResource InformationSummaryBrush}" CornerRadius="10">
                        <Grid>
                            <Border Width="40" Height="40" HorizontalAlignment="Left" Margin="10,0,0,0" CornerRadius="10">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SoftBlueBrush}"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="Image"><Setter Property="Background" Value="{DynamicResource LavenderBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Failure"><Setter Property="Background" Value="{DynamicResource SoftDangerBrush}"/></DataTrigger>
                                </Style.Triggers></Style></Border.Style>
                                <Image Source="{Binding IconSource}" Width="24" Height="24"/>
                            </Border>
                            <TextBlock x:Name="InformationSummaryTitle" Text="{Binding SummaryTitle}" ToolTip="{Binding SummaryTitle}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" Margin="66,10,10,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SummaryDetail}" ToolTip="{Binding SummaryDetail}" Foreground="{DynamicResource MutedBrush}" Margin="66,24,10,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="InformationFields" ItemsSource="{Binding Fields}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid MinHeight="30">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text7A8599Brush}" TextWrapping="Wrap" Margin="0,0,10,8"/>
                                <TextBlock x:Name="InformationValue" Grid.Column="1" Text="{Binding Value}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextInformationValueBrush}"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Failure"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</ui:FluentWindow>
