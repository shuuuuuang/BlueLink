<ui:FluentWindow x:Class="BlueLink.ImagePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="{loc:Text '图片预览'}" Width="1000" Height="700" MinWidth="720" MinHeight="480"
    Icon="/BlueLink;component/Assets/bluelink.ico" Background="{DynamicResource SurfaceBrush}"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    FontFamily="{StaticResource HomeFont}" UseLayoutRounding="True" ShowInTaskbar="False"
    Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" CommandTarget="{Binding ElementName=PreviewRoot}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <DrawingBrush x:Key="TransparencyGridBrush" TileMode="Tile"
            Viewport="0,0,56,56" ViewportUnits="Absolute" Viewbox="0,0,56,56" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource PreviewCheckerBaseBrush}" Geometry="M0,0 H56 V56 H0 Z"/>
                    <GeometryDrawing Brush="{DynamicResource PreviewCheckerAlternateBrush}" Geometry="M28,0 H56 V28 H28 Z M0,28 H28 V56 H0 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PreviewToolButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="{StaticResource ClientControlHeight}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource HomeFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PreviewToolBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MouseOverBackground" Value="{DynamicResource PreviewToolHoverBrush}"/>
            <Setter Property="PressedBackground" Value="{DynamicResource PreviewToolPressedBrush}"/>
            <Setter Property="PressedForeground" Value="{DynamicResource InkBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=PreviewTools}" Value="True">
                    <Setter Property="Width" Value="{StaticResource ClientControlHeight}"/>
                    <Setter Property="Padding" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
                    <Setter Property="PressedForeground" Value="{DynamicResource BlueBrush}"/>
                    <Setter Property="MouseOverBorderBrush" Value="{DynamicResource BlueBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewToolLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=PreviewTools}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewZoomSegmentButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="{StaticResource ClientControlHeight}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MouseOverBackground" Value="{DynamicResource PreviewToolHoverBrush}"/>
            <Setter Property="PressedBackground" Value="{DynamicResource PreviewToolPressedBrush}"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="PreviewRoot" Background="{DynamicResource SurfaceBrush}" SizeChanged="PreviewRoot_SizeChanged">
        <Grid.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed"/>
        </Grid.CommandBindings>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="PreviewTitleBar" ButtonsForeground="{DynamicResource InkBrush}" Height="64" Title=""
            ShowMinimize="False" ShowMaximize="False" ShowClose="False">
            <!-- TitleBar's native hit testing recognizes its content slots as interactive. -->
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="PreviewCloseButton" Width="32" Height="32" MinWidth="0" MinHeight="0" CornerRadius="8" Padding="6"
                    Margin="0,0,20,0" HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Transparent"
                    Background="Transparent" BorderThickness="0" ToolTip="{loc:Text '关闭'}" AutomationProperties.Name="{loc:Text '关闭'}"
                    Command="ApplicationCommands.Close" CommandTarget="{Binding ElementName=PreviewRoot}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="20" Height="20" Background="{DynamicResource MutedBrush}">
                        <Border.OpacityMask><ImageBrush ImageSource="/BlueLink;component/Assets/Figma/preview-close.png" Stretch="Fill"/></Border.OpacityMask>
                    </Border>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Grid x:Name="PreviewHeaderContent" Margin="14,0,64,0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{DynamicResource SoftBlueBrush}" CornerRadius="9">
                <Border Width="20" Height="20" Background="{DynamicResource BlueBrush}">
                    <Border.OpacityMask><ImageBrush ImageSource="/BlueLink;component/Assets/Figma/preview-header-image.png" Stretch="Fill"/></Border.OpacityMask>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleBarFileName" FontSize="{StaticResource ClientFont14}" FontWeight="Medium" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ImageInfoText" FontSize="11" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0"
                    Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <Border x:Name="ImageViewport" Grid.Row="1" Background="{DynamicResource TransparencyGridBrush}" ClipToBounds="True" Cursor="Arrow"
            PreviewMouseWheel="ImageViewport_MouseWheel" MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
            MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp" MouseMove="ImageViewport_MouseMove"
            MouseLeave="ImageViewport_MouseLeave" SizeChanged="ImageViewport_SizeChanged">
            <Grid>
                <Canvas x:Name="ImageSurface" ClipToBounds="False" Background="Transparent">
                    <Image x:Name="PreviewImage" Canvas.Left="0" Canvas.Top="0" Stretch="Uniform" SnapsToDevicePixels="True"
                        RenderTransformOrigin="0,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform><MatrixTransform x:Name="ImageTransform"/></Image.RenderTransform>
                    </Image>
                    <Border x:Name="PreviewImageBounds" BorderBrush="{DynamicResource Border7A8290Brush}" BorderThickness="0.5"
                        IsHitTestVisible="False" RenderTransform="{Binding ElementName=PreviewImage, Path=RenderTransform}"/>
                </Canvas>
                <Border x:Name="Navigator" Width="176" Height="120" Margin="0,0,14,14" Padding="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10"
                    Visibility="Collapsed" IsHitTestVisible="False">
                    <Canvas x:Name="NavigatorCanvas" Width="168" Height="112" ClipToBounds="True" Background="{DynamicResource TransparencyGridBrush}">
                        <Image x:Name="NavigatorImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform><RotateTransform x:Name="NavigatorRotation" Angle="0"/></Image.RenderTransform>
                        </Image>
                        <Border x:Name="NavigatorCrop" Background="{DynamicResource PreviewViewportTintBrush}" BorderBrush="{DynamicResource BlueBrush}"
                            BorderThickness="2" CornerRadius="3"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="PreviewFooter" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <StackPanel x:Name="PreviewTools" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="PreviewZoomControl" Width="142" Height="{StaticResource ClientControlHeight}" Background="{DynamicResource PreviewToolBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="64"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                        <ui:Button x:Name="ZoomOutButton" ToolTip="{loc:Text '缩小'}" AutomationProperties.Name="{loc:Text '缩小图片'}"
                            Click="ZoomOut_Click" Style="{StaticResource PreviewZoomSegmentButtonStyle}">
                            <Image Source="{DynamicResource FigmaIcon-preview-minus}" Width="20" Height="20"/>
                        </ui:Button>
                        <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100%" FontSize="13" FontWeight="Medium"
                            Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ui:Button x:Name="ZoomInButton" Grid.Column="2" ToolTip="{loc:Text '放大'}" AutomationProperties.Name="{loc:Text '放大图片'}"
                            Click="ZoomIn_Click" Style="{StaticResource PreviewZoomSegmentButtonStyle}">
                            <Image Source="{DynamicResource FigmaIcon-preview-plus}" Width="20" Height="20"/>
                        </ui:Button>
                    </Grid>
                </Border>
                <ui:Button x:Name="FitButton" ToolTip="{loc:Text '适应窗口'}" AutomationProperties.Name="{loc:Text '适应窗口'}"
                    Click="Fit_Click" Style="{StaticResource PreviewToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="FitIcon" Width="20" Height="20" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}">
                            <Border.OpacityMask><ImageBrush ImageSource="/BlueLink;component/Assets/Figma/preview-fit.png" Stretch="Fill"/></Border.OpacityMask>
                        </Border>
                        <TextBlock x:Name="FitLabel" Text="{loc:Text '适应窗口'}" Style="{StaticResource PreviewToolLabelStyle}"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="ActualSizeButton" Content="1:1" ToolTip="{loc:Text '一比一显示'}" AutomationProperties.Name="{loc:Text '一比一显示'}"
                    Click="ActualSize_Click" Style="{StaticResource PreviewToolButtonStyle}"/>
                <ui:Button x:Name="RotateLeftButton" ToolTip="{loc:Text '向左旋转'}" AutomationProperties.Name="{loc:Text '向左旋转'}"
                    Click="RotateLeft_Click" Style="{StaticResource PreviewToolButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource FigmaIcon-preview-left}" Width="20" Height="20"/>
                        <TextBlock x:Name="RotateLeftLabel" Text="{loc:Text '向左旋转'}" Style="{StaticResource PreviewToolLabelStyle}"/></StackPanel>
                </ui:Button>
                <ui:Button x:Name="RotateRightButton" ToolTip="{loc:Text '向右旋转'}" AutomationProperties.Name="{loc:Text '向右旋转'}"
                    Click="RotateRight_Click" Style="{StaticResource PreviewToolButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource FigmaIcon-preview-right}" Width="20" Height="20"/>
                        <TextBlock x:Name="RotateRightLabel" Text="{loc:Text '向右旋转'}" Style="{StaticResource PreviewToolLabelStyle}"/></StackPanel>
                </ui:Button>
                <ui:Button x:Name="ResetButton" ToolTip="{loc:Text '重置'}" AutomationProperties.Name="{loc:Text '重置图片预览'}"
                    Click="Reset_Click" Style="{StaticResource PreviewToolButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource FigmaIcon-preview-reset}" Width="20" Height="20"/>
                        <TextBlock x:Name="ResetLabel" Text="{loc:Text '重置'}" Style="{StaticResource PreviewToolLabelStyle}"/></StackPanel>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
