<ui:FluentWindow x:Class="BlueLink.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="图片预览"
        Width="1180"
        Height="820"
        MinWidth="940"
        MinHeight="600"
        Icon="/BlueLink;component/Assets/bluelink.ico"
        Background="#FFFFFF"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        UseLayoutRounding="True"
        Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.Resources>
        <DrawingBrush x:Key="TransparencyGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,20,20"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F7F9FC" Geometry="M0,0 H20 V20 H0 Z" />
                    <GeometryDrawing Brush="#E7ECF3" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PreviewToolButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <SolidColorBrush x:Key="PreviewZoomHoverBrush" Color="#E8F5FC" />
        <SolidColorBrush x:Key="PreviewZoomPressedBrush" Color="#D8ECF8" />
        <Style x:Key="PreviewZoomSegmentButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewZoomSegmentChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PreviewZoomHoverBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsMouseCaptureWithin" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PreviewZoomPressedBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <Grid MaxWidth="720">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="26" Height="26" Source="/BlueLink;component/Assets/bluelink-logo.png" />
                    <TextBlock x:Name="TitleBarFileName"
                               Grid.Column="1"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#14213A"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border x:Name="ImageViewport"
                Grid.Row="1"
                Background="{StaticResource TransparencyGridBrush}"
                ClipToBounds="True"
                Cursor="Arrow"
                PreviewMouseWheel="ImageViewport_MouseWheel"
                MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
                MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp"
                MouseMove="ImageViewport_MouseMove"
                MouseLeave="ImageViewport_MouseLeave"
                SizeChanged="ImageViewport_SizeChanged">
            <Grid>
                <Canvas x:Name="ImageSurface"
                        ClipToBounds="False"
                        Background="Transparent">
                <Image x:Name="PreviewImage"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderTransformOrigin="0,0"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ImageTransform" />
                    </Image.RenderTransform>
                </Image>
                </Canvas>

                <Border x:Name="Navigator"
                        Width="196"
                        Height="136"
                        Margin="0,0,18,18"
                        Padding="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#EFFFFFFF"
                        BorderBrush="#7A8290"
                        BorderThickness="2"
                        CornerRadius="9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Canvas x:Name="NavigatorCanvas"
                            Width="180"
                            Height="120"
                            ClipToBounds="True"
                            Background="{StaticResource TransparencyGridBrush}">
                        <Image x:Name="NavigatorImage"
                               Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="NavigatorRotation" Angle="0" />
                            </Image.RenderTransform>
                        </Image>
                        <Border x:Name="NavigatorCrop"
                                Background="#383A86FF"
                                BorderBrush="#0878D1"
                                BorderThickness="2"
                                CornerRadius="2" />
                    </Canvas>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D9E2F0"
                BorderThickness="0,1,0,0"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="164"
                            Height="42"
                            Background="#FFFFFF"
                            BorderBrush="#D9E2F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="9,0,0,9"
                                    Style="{StaticResource PreviewZoomSegmentChromeStyle}">
                                <ui:Button Content="−"
                                           FontSize="21"
                                           ToolTip="缩小"
                                           AutomationProperties.Name="缩小图片"
                                           Click="ZoomOut_Click"
                                           Style="{StaticResource PreviewZoomSegmentButtonStyle}" />
                            </Border>
                            <TextBlock x:Name="ZoomText"
                                       Grid.Column="1"
                                       Text="100%"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="14"
                                       Foreground="#344054"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="当前缩放比例" />
                            <Border Grid.Column="2"
                                    CornerRadius="0,9,9,0"
                                    Style="{StaticResource PreviewZoomSegmentChromeStyle}">
                                <ui:Button Content="＋"
                                           FontSize="18"
                                           ToolTip="放大"
                                           AutomationProperties.Name="放大图片"
                                           Click="ZoomIn_Click"
                                           Style="{StaticResource PreviewZoomSegmentButtonStyle}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ui:Button Margin="14,0,0,0"
                               Content="适应窗口"
                               AutomationProperties.Name="适应窗口"
                               Click="Fit_Click"
                               Style="{StaticResource PreviewToolButtonStyle}" />
                    <ui:Button Margin="8,0,0,0"
                               Content="1:1"
                               AutomationProperties.Name="一比一显示"
                               Click="ActualSize_Click"
                               Style="{StaticResource PreviewToolButtonStyle}" />
                    <ui:Button Margin="14,0,0,0"
                               Content="↶  向左旋转"
                               AutomationProperties.Name="向左旋转"
                               Click="RotateLeft_Click"
                               Style="{StaticResource PreviewToolButtonStyle}" />
                    <ui:Button Margin="8,0,0,0"
                               Content="↷  向右旋转"
                               AutomationProperties.Name="向右旋转"
                               Click="RotateRight_Click"
                               Style="{StaticResource PreviewToolButtonStyle}" />
                    <ui:Button Margin="8,0,0,0"
                               Content="⟳  重置"
                               AutomationProperties.Name="重置图片预览"
                               Click="Reset_Click"
                               Style="{StaticResource PreviewToolButtonStyle}" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           MinWidth="190"
                           Content="在资源管理器中打开"
                           Appearance="Primary"
                           AutomationProperties.Name="在资源管理器中打开"
                           Click="Locate_Click"
                           Style="{StaticResource PreviewToolButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
