<ui:FluentWindow x:Class="BlueLink.FeedbackReadyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:BlueLink.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{loc:Text '反馈包已生成'}" Width="560" Height="360" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None" UseLayoutRounding="True"
    Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource HomeFont}"
    PreviewKeyDown="Window_PreviewKeyDown" Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/SettingsWindow.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></ui:FluentWindow.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid Margin="27,23,27,37">
                <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="27"/><RowDefinition Height="48"/><RowDefinition Height="24"/><RowDefinition Height="94"/><RowDefinition Height="34"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                <TextBlock Text="{loc:Text '反馈包已生成'}" FontSize="21" FontWeight="Bold" LineHeight="31" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource SettingsInkBrush}"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48"><Image Source="Assets/Figma/feedback-success.png"/><TextBlock Text="✓" Foreground="{DynamicResource Text0EA963Brush}" FontSize="{StaticResource ClientFont18}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    <StackPanel Grid.Column="2" Margin="0,2,0,0">
                        <TextBlock Text="{loc:Text '反馈信息已保存在本机'}" Style="{StaticResource SettingsLabelStyle}" FontSize="{StaticResource ClientFont14}" LineHeight="24" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock Text="{loc:Text '不会自动上传或发送'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,5,0,0" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="4" Background="{DynamicResource PanelF6F9FDBrush}" CornerRadius="8" Padding="12,13,12,9">
                    <StackPanel>
                        <TextBlock x:Name="PackageName" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource SettingsLabelStyle}" FontSize="{StaticResource ClientFont13}" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="PackageDirectory" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,7,0,8" Style="{StaticResource SettingsDescriptionStyle}" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="DiagnosticsNotice" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" LineHeight="17" LineStackingStrategy="BlockLineHeight" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="5" x:Name="OperationStatus" Foreground="{DynamicResource SettingsDangerBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{loc:Text '反馈包操作状态'}"/>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{loc:Text '复制路径'}" Click="CopyPath_Click" Width="110" Style="{StaticResource SettingsButtonStyle}"/>
                    <ui:Button Content="{loc:Text '打开文件夹'}" Click="OpenFolder_Click" Width="110" Margin="10,0" Style="{StaticResource SettingsButtonStyle}"/>
                    <ui:Button Foreground="{DynamicResource OnAccentBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Background="{DynamicResource PrimaryBrush}" Content="{loc:Text '完成'}" Click="Done_Click" Width="112" Appearance="Primary" Style="{StaticResource SettingsButtonStyle}"/>
                </StackPanel>
            </Grid>
            <ui:Button Width="32" Height="32" MinWidth="0" MinHeight="0" CornerRadius="8" Margin="0,17,17,0" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="6" BorderThickness="0" AutomationProperties.Name="{loc:Text '关闭'}" Click="Done_Click"><ui:SymbolIcon Symbol="Dismiss20" FontSize="20" Foreground="{DynamicResource SettingsMutedBrush}"/></ui:Button>
        </Grid>
    </Border>
</ui:FluentWindow>
