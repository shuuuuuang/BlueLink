<UserControl x:Class="BlueLink.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BlueLink" xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="{StaticResource HomeFont}" Foreground="{DynamicResource SettingsInkBrush}"
    Background="{DynamicResource SettingsCanvasBrush}" UseLayoutRounding="True"
    AutomationProperties.AutomationId="SettingsPage" PreviewKeyDown="SettingsPage_PreviewKeyDown"
    SizeChanged="Page_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SettingsWindow.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SettingsCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="SettingsFooterRow" Height="76" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SettingsNavigationBrush}"
                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,16,12,12" Height="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text '设置'}" FontSize="{StaticResource ClientFont18}" FontWeight="Bold" Foreground="{DynamicResource SettingsInkBrush}" FontFamily="{StaticResource HomeFont}" VerticalAlignment="Center"/>
                        <ui:Button x:Name="ReturnToHomeButton" Grid.Column="1" HorizontalAlignment="Right" MinWidth="96" FontSize="12" Height="32" Padding="6,0" Click="Cancel_Click" AutomationProperties.Name="{loc:Text '返回主界面'}" Style="{StaticResource SettingsButtonStyle}">
                            <StackPanel Orientation="Horizontal"><Image Source="/BlueLink;component/Assets/Figma/settings-back.png" Width="16" Height="15" Margin="0,0,4,0"/><TextBlock Text="{loc:Text '返回主界面'}" VerticalAlignment="Center"/></StackPanel>
                        </ui:Button>
                    </Grid>
                <ui:NavigationView x:Name="SettingsNavigation"
                                   AutomationProperties.Name="{loc:Text '设置分类'}"
                                   Background="Transparent"
                                   IsBackButtonVisible="Collapsed"
                                   IsPaneToggleVisible="False"
                                   IsPaneOpen="True"
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="283"
                                   CompactPaneLength="283"
                                   HeaderVisibility="Collapsed"
                                   AlwaysShowHeader="False">
                    <ui:NavigationView.Resources>
                        <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{DynamicResource SettingsSoftBlueColor}"/>
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource SettingsBlueColor}"/>
                    </ui:NavigationView.Resources>
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="GeneralNavigationItem" Content="{loc:Text '通用'}" TargetPageTag="general" IsActive="True" Click="NavigationItem_Click" AutomationProperties.Name="{loc:Text '通用'}" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:ImageIcon Width="20" Height="20"><ui:ImageIcon.Style>
                                <Style TargetType="ui:ImageIcon">
                                    <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-active}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ui:ImageIcon.Style></ui:ImageIcon></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="ConnectionNavigationItem" Content="{loc:Text '连接与设备'}" TargetPageTag="connection" Click="NavigationItem_Click" AutomationProperties.Name="{loc:Text '连接与设备'}" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:ImageIcon Width="20" Height="20"><ui:ImageIcon.Style>
                                <Style TargetType="ui:ImageIcon">
                                    <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-connections}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-connections-active}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ui:ImageIcon.Style></ui:ImageIcon></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="FilesNavigationItem" Content="{loc:Text '文件与存储'}" TargetPageTag="files" Click="NavigationItem_Click" AutomationProperties.Name="{loc:Text '文件与存储'}" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:ImageIcon Width="20" Height="20"><ui:ImageIcon.Style>
                                <Style TargetType="ui:ImageIcon">
                                    <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-files}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-files-active}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ui:ImageIcon.Style></ui:ImageIcon></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="PrivacyNavigationItem" Content="{loc:Text '隐私与数据'}" TargetPageTag="privacy" Click="NavigationItem_Click" AutomationProperties.Name="{loc:Text '隐私与数据'}" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:ImageIcon Width="20" Height="20"><ui:ImageIcon.Style>
                                <Style TargetType="ui:ImageIcon">
                                    <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-privacy}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-privacy-active}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ui:ImageIcon.Style></ui:ImageIcon></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="AboutNavigationItem" Content="{loc:Text '关于'}" TargetPageTag="about" Click="NavigationItem_Click" AutomationProperties.Name="{loc:Text '关于'}" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:ImageIcon Width="20" Height="20"><ui:ImageIcon.Style>
                                <Style TargetType="ui:ImageIcon">
                                    <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-about}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource FigmaIcon-settings-about-active}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ui:ImageIcon.Style></ui:ImageIcon></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SettingsPageScrollStyle}">
                    <Grid>
                        <StackPanel x:Name="GeneralPage" AutomationProperties.Name="{loc:Text '通用设置页面'}">
                            <TextBlock Text="{loc:Text '通用'}" Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Text '管理蓝联的外观、语言、启动方式与窗口行为'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,-6,0,16"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '外观与语言'}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="216"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{loc:Text '主题'}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="{loc:Text '选择浅色、深色或跟随 Windows 系统设置'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeBox" Grid.Column="1" ItemTemplate="{StaticResource SettingsPreferenceTemplate}" SelectedValuePath="Value" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="{loc:Text '主题'}"/>
                                    </Grid>
                                    <Border Height="1" Margin="0,10" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="216"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{loc:Text '语言'}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="{loc:Text '应用界面语言'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageBox" Grid.Column="1" ItemTemplate="{StaticResource SettingsPreferenceTemplate}" SelectedValuePath="Value" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="{loc:Text '语言'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '窗口'}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Text '关闭主窗口时'}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,12,0" Text="{loc:Text '选择继续保持后台会话，或完整退出蓝联'}" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="CloseBehaviorBox" Grid.Column="1" AutomationProperties.Name="{loc:Text '关闭主窗口时'}" Style="{StaticResource SettingsComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{loc:Text '通知'}" Style="{StaticResource SettingsSectionTitleStyle}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '消息通知'}" Style="{StaticResource SettingsLabelStyle}"/><ui:ToggleSwitch x:Name="MessageNotificationsToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '消息通知'}" Style="{StaticResource SettingsToggleStyle}"/></Grid><Border Style="{StaticResource SettingsRowDividerStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '连接状态通知'}" Style="{StaticResource SettingsLabelStyle}"/><ui:ToggleSwitch x:Name="ConnectionNotificationsToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '连接状态通知'}" Style="{StaticResource SettingsToggleStyle}"/></Grid><Border Style="{StaticResource SettingsRowDividerStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '传输完成通知'}" Style="{StaticResource SettingsLabelStyle}"/><ui:ToggleSwitch x:Name="TransferNotificationsToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '传输完成通知'}" Style="{StaticResource SettingsToggleStyle}"/></Grid></StackPanel></Border></StackPanel>

                        <StackPanel x:Name="ConnectionPage" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '连接与设备设置页面'}">
                            <TextBlock Text="{loc:Text '连接与设备'}" Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Text '管理 USB 与蓝牙连接、设备扫描和信任关系'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,-6,0,16"/>
                            <Border x:Name="LocalDeviceSettingsCard" Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Text '本机设备'}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                        <TextBlock Text="{Binding LocalDeviceDisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalDeviceDisplayName}" Style="{StaticResource SettingsLabelStyle}" Margin="0,10,0,4"/>
                                        <TextBlock Text="{loc:Text '其他设备将使用此名称识别这台电脑'}" Style="{StaticResource SettingsDescriptionStyle}"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Width="110" BorderBrush="{DynamicResource BlueBrush}" Foreground="{DynamicResource BlueBrush}" Content="{loc:Text '修改名称'}" Click="EditDeviceName_Click" AutomationProperties.Name="{loc:Text '修改本机设备名'}" Style="{StaticResource SettingsButtonStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ConnectionPreferencesCard" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '连接偏好'}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text 'USB 高速传输'}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="{loc:Text '开启后，自动优先使用设备间可用的 USB 连接。'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ConnectionUsbToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '启用 USB 高速传输'}" Style="{StaticResource SettingsToggleStyle}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text '启动时扫描附近设备'}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="{loc:Text '蓝联启动后自动查找附近正在运行蓝联的设备'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ScanStartupToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '启动时扫描附近设备'}" Style="{StaticResource SettingsToggleStyle}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text '允许被附近设备发现'}" Style="{StaticResource SettingsLabelStyle}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="DiscoveryToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '允许被附近设备发现'}" Style="{StaticResource SettingsToggleStyle}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text '自动连接已信任设备'}" Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="{loc:Text '发现此前已核对安全码的设备后自动尝试连接'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '自动连接已信任设备'}" Style="{StaticResource SettingsToggleStyle}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text '断线后自动重连'}" Style="{StaticResource SettingsLabelStyle}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ReconnectToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '断线后自动重连'}" Style="{StaticResource SettingsToggleStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TrustedDevicesCard" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{loc:Text '信任管理'}" Style="{StaticResource SettingsSectionTitleStyle}"/><TextBlock Text="{loc:Text '移除后，再次连接该设备时需要重新核对安全码。'}" Margin="0,8,12,0" Style="{StaticResource SettingsDescriptionStyle}"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TrustedDeviceCountText}" Margin="0,6,14,0" Style="{StaticResource SettingsDescriptionStyle}"/>
                                        <ui:Button Grid.Column="2" Width="110" VerticalAlignment="Top" Content="{loc:Text '批量移除'}" Visibility="{Binding HasTrustedDevices, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding HasTrustedDevices}" Click="ForgetAllPeers_Click" AutomationProperties.Name="{loc:Text '批量移除信任'}" Style="{StaticResource SettingsButtonStyle}"/>
                                    </Grid>
                                    <Border Background="{DynamicResource PanelF8FAFDBrush}" BorderBrush="{DynamicResource BorderD1D9E5Brush}" BorderThickness="1" CornerRadius="10" MinHeight="172">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTrustedDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                            <Image Source="Assets/Figma/settings-trust-empty.png" Width="34" Height="34" Margin="0,0,0,10"/>
                                            <TextBlock Text="{loc:Text '暂无已信任设备'}" HorizontalAlignment="Center" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                            <TextBlock Text="{loc:Text '离线列表保留历史会话，不代表仍受信任。连接设备并核对安全码后，会显示在这里。'}" Margin="0,8,0,0" Style="{StaticResource SettingsDescriptionStyle}" FontSize="{StaticResource ClientFont13}" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TrustedDevices}" AutomationProperties.Name="{loc:Text '已信任设备列表'}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinHeight="76" Background="{DynamicResource PanelF8FAFDBrush}" BorderBrush="{DynamicResource BorderEEF1F5Brush}" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,10"><Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SettingsSoftBlueBrush}"><Image Width="20" Height="20" Source="{Binding PlatformIconSource}"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PeerName}" FontFamily="{StaticResource HomeFont}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource SettingsInkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PeerName}"/>
                                                        <TextBlock Text="{Binding PeerId}" FontFamily="{StaticResource HomeFont}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource SettingsMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PeerId}"/>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="2" Content="{loc:Text '移除'}" Click="ForgetPeer_Click" AutomationProperties.Name="{loc:Text '移除信任'}" Style="{StaticResource SettingsButtonStyle}" />
                                                </Grid></Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="FilesPage" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '文件与存储设置页面'}">
                            <TextBlock Text="{loc:Text '文件与存储'}" Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Text '管理接收限制、保存位置和本地存储空间'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,-6,0,16"/>
                            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{loc:Text '接收'}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{loc:Text '接收目录'}" Style="{StaticResource SettingsLabelStyle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="DownloadPathText" TextChanged="DownloadPath_Changed" AutomationProperties.Name="{loc:Text '文件保存位置'}" Style="{StaticResource SettingsTextBoxStyle}" />
                                        <ui:Button Grid.Column="1" Margin="10,0,0,0" Content="{loc:Text '更改位置'}" Click="BrowseDownload_Click" AutomationProperties.Name="{loc:Text '更改文件保存位置'}" Style="{StaticResource SettingsButtonStyle}" />
                                        <ui:Button Grid.Column="2" Margin="10,0,0,0" Content="{loc:Text '打开文件夹'}" Click="OpenDownload_Click" AutomationProperties.Name="{loc:Text '打开文件保存位置'}" Style="{StaticResource SettingsButtonStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="StorageSpaceText" Margin="0,10,0,0" FontFamily="{StaticResource HomeFont}" FontSize="12" Foreground="{DynamicResource SettingsSuccessBrush}" />
                                <Border Height="1" Margin="0,12" Background="{DynamicResource SettingsBorderBrush}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '接收前询问'}" Style="{StaticResource SettingsLabelStyle}" /><ui:ToggleSwitch x:Name="AutoDownloadToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '接收前询问'}" Style="{StaticResource SettingsToggleStyle}" /></Grid><Border Style="{StaticResource SettingsRowDividerStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '同名文件处理'}" Style="{StaticResource SettingsLabelStyle}"/><ComboBox x:Name="DuplicatePolicyBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Value" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="{loc:Text '同名文件处理'}"/></Grid>
                                    <Border Height="1" Margin="0,12" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Text '启用单文件接收上限'}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,0,0" Text="{loc:Text '超限请求最多等待 30 秒，可提高上限后继续'}" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ReceiveLimitToggle" Grid.Column="1" Checked="ReceiveLimit_Changed" Unchecked="ReceiveLimit_Changed" AutomationProperties.Name="{loc:Text '启用单文件接收上限'}" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,12" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Text '大小上限（MiB）'}" Style="{StaticResource SettingsLabelStyle}" />
                                        <ui:TextBox x:Name="ReceiveLimitText" Grid.Column="1" AutomationProperties.Name="{loc:Text '文件大小上限 MiB'}" Style="{StaticResource SettingsTextBoxStyle}" />
                                    </Grid>
                                </StackPanel></Border><Border Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Text="{loc:Text '文件显示与存储'}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Text '在聊天中显示图片缩略图'}" Style="{StaticResource SettingsLabelStyle}" /><ui:ToggleSwitch x:Name="ThumbnailsToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '显示图片缩略图'}" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                <Border Height="1" Margin="0,12" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <TextBlock Text="{loc:Text '存储空间使用情况'}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock x:Name="StorageUsageText" Margin="0,6,0,10" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <ui:Button Content="{loc:Text '清理缩略图缓存'}" HorizontalAlignment="Left" Click="ClearCache_Click" AutomationProperties.Name="{loc:Text '清理缩略图缓存'}" Style="{StaticResource SettingsButtonStyle}" />
                                </StackPanel></Border></StackPanel>

<StackPanel x:Name="PrivacyPage" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '隐私与数据设置页面'}">
                            <TextBlock Text="{loc:Text '隐私与数据'}" Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Text '控制本地记录、诊断数据与设备身份信息'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,-6,0,16"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '本地记录'}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Text '保存聊天记录'}" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,0,0" Text="{loc:Text '聊天内容只保存在这台电脑'}" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="SaveChatToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '保存聊天记录'}" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <Border Height="1" Margin="0,9,0,12" Background="{DynamicResource SettingsBorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Text '保存文件传输记录'}" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,0,0" Text="{loc:Text '记录文件名称、状态和本地保存位置'}" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="SaveTransfersToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '保存文件传输记录'}" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <Border Height="1" Margin="0,9,0,12" Background="{DynamicResource SettingsBorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Text '记录保留期限'}" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,12,0" Text="{loc:Text '到期记录会在应用启动和保存设置时清理'}" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ComboBox x:Name="RetentionBox" Grid.Column="1" AutomationProperties.Name="{loc:Text '记录保留期限'}" Style="{StaticResource SettingsComboBoxStyle}" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Text '脱敏诊断日志'}" Style="{StaticResource SettingsSectionTitleStyle}" /><TextBlock Margin="0,4,0,0" Text="{loc:Text '不记录消息内容、文件内容、密钥或安全码'}" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="1" AutomationProperties.Name="{loc:Text '启用脱敏诊断日志'}" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <ui:Button Margin="0,12,0,0" Content="{loc:Text '导出脱敏诊断日志'}" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" AutomationProperties.Name="{loc:Text '导出脱敏诊断日志'}" Style="{StaticResource SettingsButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel><StackPanel x:Name="IdentityDetailsPanel">
                                    <TextBlock Text="{loc:Text '本机设备标识'}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0" Text="{loc:Text '连接时用于核对设备身份；标识仅在本机生成和保存。'}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Padding="10,9" CornerRadius="10" Background="{DynamicResource SettingsSoftBlueBrush}"><TextBlock Text="{Binding IdentityFingerprint}" FontFamily="{StaticResource HomeFont}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsInkBrush}" TextWrapping="Wrap" /></Border>
                                        <ui:Button x:Name="ResetIdentityButton" Grid.Column="1" Margin="10,0,0,0" Content="{loc:Text '重置设备标识'}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SettingsDestructiveBrush}" BorderBrush="{DynamicResource SettingsDestructiveBrush}" Click="ResetIdentity_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                    </Grid>
                                </StackPanel></StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="{DynamicResource BorderF2C9C5Brush}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text '清除本地记录'}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,10" Text="{loc:Text '这些操作不会删除 Download 中已接收的用户文件。'}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal"><ui:Button Content="{loc:Text '清除聊天记录'}" Foreground="{DynamicResource OnAccentBrush}" Background="{DynamicResource SettingsClearBrush}" BorderBrush="{DynamicResource SettingsClearBrush}" Appearance="Danger" Click="ClearChat_Click" AutomationProperties.Name="{loc:Text '清除聊天记录'}" Style="{StaticResource SettingsButtonStyle}" /><ui:Button Margin="10,0,0,0" Content="{loc:Text '清除传输记录'}" Foreground="{DynamicResource OnAccentBrush}" Background="{DynamicResource SettingsClearBrush}" BorderBrush="{DynamicResource SettingsClearBrush}" Appearance="Danger" Click="ClearTransfers_Click" AutomationProperties.Name="{loc:Text '清除传输记录'}" Style="{StaticResource SettingsButtonStyle}" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '关于页面'}">
                            <TextBlock Text="{loc:Text '关于'}" Style="{StaticResource SettingsPageTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text '查看版本、更新与支持信息'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,16"/>
                            <Border x:Name="AboutBrandCard" Style="{StaticResource SettingsCardStyle}" Padding="12,10" MinHeight="148">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Width="52" Height="52" Source="/BlueLink;component/Assets/bluelink-logo.png" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Text '蓝联 BlueLink'}" FontSize="{StaticResource ClientFont20}" FontWeight="Bold" LineHeight="31" LineStackingStrategy="BlockLineHeight" Style="{StaticResource SettingsLabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ProductVersionText" Style="{StaticResource SettingsDescriptionStyle}" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource SettingsDescriptionStyle}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource SettingsBlueBrush}"/><Setter Property="LineHeight" Value="16"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/></Style></StackPanel.Resources>
                                        <TextBlock x:Name="RuntimeVersionText"/>
                                        <TextBlock Text="  ·  "/>
                                        <TextBlock x:Name="RuntimeArchitectureText"/>
                                        <TextBlock Text="  ·  BTX/1.1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{loc:Text '更新与支持'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="12,0">
                                <StackPanel x:Name="AboutSupportLinks">
                                    <ui:Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" AutomationProperties.Name="{loc:Text '检查更新'}" Style="{StaticResource SettingsAboutLinkStyle}" HorizontalContentAlignment="Stretch">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Text '检查更新'}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="UpdateStatusText" Grid.Column="1" Text="{Binding Updates.CheckStatus}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SettingsMutedBrush}" VerticalAlignment="Center" Margin="10,0,14,0"/>
                                            <Image Grid.Column="2" Width="20" Height="20" Source="{DynamicResource SettingsChevronRight}"/>
                                        </Grid>
                                    </ui:Button>
                                    <Border Height="1" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <ui:Button Content="{loc:Text '帮助与反馈'}" ContentTemplate="{StaticResource SettingsAboutLinkTemplate}" Click="ShowHelp_Click" AutomationProperties.Name="{loc:Text '帮助与反馈'}" Style="{StaticResource SettingsAboutLinkStyle}"/>
                                    <Border Height="1" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <ui:Button Content="{loc:Text '开源许可'}" ContentTemplate="{StaticResource SettingsAboutLinkTemplate}" Click="ShowLicenses_Click" AutomationProperties.Name="{loc:Text '开源许可'}" Style="{StaticResource SettingsAboutLinkStyle}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{loc:Text '法律信息'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="12,0">
                                <StackPanel>
                                    <ui:Button Content="{loc:Text '隐私政策'}" ContentTemplate="{StaticResource SettingsAboutLinkTemplate}" Click="ShowPrivacy_Click" AutomationProperties.Name="{loc:Text '隐私政策'}" Style="{StaticResource SettingsAboutLinkStyle}"/>
                                    <Border Height="1" Background="{DynamicResource SettingsBorderBrush}"/>
                                    <ui:Button Content="{loc:Text '用户协议'}" ContentTemplate="{StaticResource SettingsAboutLinkTemplate}" Click="ShowAgreement_Click" AutomationProperties.Name="{loc:Text '用户协议'}" Style="{StaticResource SettingsAboutLinkStyle}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="© 2026 BlueLink. Bluetooth only." Style="{StaticResource SettingsDescriptionStyle}" HorizontalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                        <Grid x:Name="HelpPage" Margin="{StaticResource SettingsPageInset}" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '帮助与反馈页面'}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button x:Name="HelpBackButton" Width="36" Height="36" MinWidth="36" Padding="9" Margin="0,0,10,0" Click="HelpBack_Click" AutomationProperties.Name="{loc:Text '返回关于'}" Style="{StaticResource SettingsButtonStyle}">
                                    <Image Width="17" Height="15" Source="{DynamicResource FigmaIcon-settings-back}"/>
                                </ui:Button>
                                <TextBlock x:Name="HelpPageTitle" Text="{loc:Text '帮助与反馈'}" Style="{StaticResource SettingsPageTitleStyle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="HelpPageSubtitle" Grid.Row="1" Text="{loc:Text '查找解决方案，或生成由你自行提交的反馈信息'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,16"/>
                            <Grid x:Name="HelpColumns" Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="HelpNavigationColumn" Width="360*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="HelpDetailColumn" Width="836*"/></Grid.ColumnDefinitions>
                                <Border x:Name="HelpNavigationCard" Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="8">
                                    <ScrollViewer x:Name="HelpNavigationScroll" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                    <StackPanel x:Name="HelpTopics">
                                        <ui:Button Tag="connection" Click="HelpTopic_Click" AutomationProperties.Name="{loc:Text '帮助：连接与配对'}" Style="{StaticResource SettingsHelpTopicStyle}"/>
                                        <Border Height="1" Margin="8,8" Background="{DynamicResource SettingsBorderBrush}"/>
                                        <ui:Button Tag="messages" Click="HelpTopic_Click" AutomationProperties.Name="{loc:Text '帮助：消息与文件'}" Style="{StaticResource SettingsHelpTopicStyle}"/>
                                        <Border Height="1" Margin="8,8" Background="{DynamicResource SettingsBorderBrush}"/>
                                        <ui:Button Tag="faq" Click="HelpTopic_Click" AutomationProperties.Name="{loc:Text '帮助：常见问题'}" Style="{StaticResource SettingsHelpTopicStyle}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DocumentTopics" Visibility="Collapsed" AutomationProperties.Name="{loc:Text '文档目录'}"/>
                                    </Grid>
                                    </ScrollViewer>
                                </Border>
                                <Grid x:Name="LicenseNavigation" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <ui:TextBox x:Name="LicenseQuery" PlaceholderText="{loc:Text '搜索组件或许可证'}" TextChanged="LicenseQuery_Changed" AutomationProperties.Name="{loc:Text '搜索开源许可'}" Style="{StaticResource SettingsTextBoxStyle}" Height="32" FontSize="12" IconPlacement="Left">
                                        <ui:TextBox.Icon><ui:ImageIcon Width="16" Height="16" Source="{DynamicResource FigmaIcon-search}"/></ui:TextBox.Icon>
                                    </ui:TextBox>
                                    <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="6">
                                        <ScrollViewer x:Name="LicenseNavigationScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LicenseEntries" AutomationProperties.Name="{loc:Text '开源组件列表'}"/></ScrollViewer>
                                    </Border>
                                </Grid>
                                <Border x:Name="HelpDetailCard" Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="12">
                                    <ScrollViewer x:Name="HelpDetailScroll" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <StackPanel x:Name="FeedbackForm" AutomationProperties.Name="{loc:Text '问题反馈表单'}">
                                            <TextBlock Text="{loc:Text '问题反馈'}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="{StaticResource ClientFont16}" LineHeight="27" LineStackingStrategy="BlockLineHeight"/>
                                            <TextBlock Text="{loc:Text '反馈不会自动上传；生成后由你选择提交方式。'}" Style="{StaticResource SettingsDescriptionStyle}" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,5,0,16"/>
                                            <TextBlock Text="{loc:Text '问题类型'}" Style="{StaticResource SettingsLabelStyle}" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="FeedbackCategory" Height="32" AutomationProperties.Name="{loc:Text '问题类型'}" Style="{StaticResource SettingsComboBoxStyle}"/>
                                            <TextBlock x:Name="FeedbackDescriptionLabel" Text="{loc:Text '问题描述'}" Style="{StaticResource SettingsLabelStyle}" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" Margin="0,16,0,7"/>
                                            <Border x:Name="FeedbackDescriptionBorder" Height="160" CornerRadius="8" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" Background="{DynamicResource SettingsCardBrush}">
                                                <Grid>
                                                    <ui:TextBox x:Name="FeedbackDescription" Height="Auto" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="FeedbackDescription_Changed" PlaceholderText="{loc:Text '请描述问题、复现步骤和期望结果'}" AutomationProperties.Name="{loc:Text '问题描述'}" Style="{StaticResource SettingsTextBoxStyle}" FontSize="13" BorderThickness="0" Background="Transparent" Padding="13,10,13,44">
                                                        <ui:TextBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
                                                            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent"/>
                                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                        </ui:TextBox.Resources>
                                                    </ui:TextBox>
                                                    <TextBlock x:Name="FeedbackValidationMessage" Visibility="Collapsed" IsHitTestVisible="False" Text="{loc:Text '请填写问题描述后再生成反馈包。'}" Foreground="{DynamicResource SettingsDangerBrush}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="13,63,13,0" VerticalAlignment="Top"/>
                                                    <TextBlock x:Name="FeedbackCharacterCount" Text="0 / 1000" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="13,0,13,10" Style="{StaticResource SettingsDescriptionStyle}" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                            <Border Background="{DynamicResource PanelF6F9FDBrush}" CornerRadius="8" Padding="12,10" MinHeight="74" Margin="0,21,0,0">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Text '附加诊断信息'}" Style="{StaticResource SettingsLabelStyle}" FontSize="{StaticResource ClientFont13}" LineHeight="21" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="{loc:Text '开启后，点击“生成反馈包”时会一并打包诊断日志'}" Style="{StaticResource SettingsDescriptionStyle}" FontSize="11" LineHeight="17" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0"/></StackPanel>
                                                    <ui:ToggleSwitch x:Name="FeedbackDiagnostics" Grid.Column="1" IsChecked="False" AutomationProperties.Name="{loc:Text '反馈附加诊断信息'}" Style="{StaticResource SettingsToggleStyle}"/>
                                                </Grid>
                                            </Border>
                                            <ui:Button Foreground="{DynamicResource OnAccentBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Background="{DynamicResource PrimaryBrush}" x:Name="GenerateFeedbackButton" Content="{loc:Text '生成反馈包'}" Appearance="Primary" Width="216" HorizontalAlignment="Right" Margin="0,15,0,0" Click="GenerateFeedback_Click" AutomationProperties.Name="{loc:Text '生成反馈包'}" Style="{StaticResource SettingsButtonStyle}">
                                                <ui:Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#990771FE"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White"/>
                                                </ui:Button.Resources>
                                            </ui:Button>
                                            <!-- The official template has a 1-DIP inner margin; height 4 leaves a visible 2-DIP track. -->
                                            <Grid Height="15"><ProgressBar x:Name="FeedbackProgress" IsIndeterminate="True" Height="4" BorderThickness="0" Visibility="Collapsed" Background="{DynamicResource SettingsBorderBrush}" Foreground="{DynamicResource SettingsBlueBrush}" VerticalAlignment="Center">
                                                <ProgressBar.Resources>
                                                    <SolidColorBrush x:Key="ProgressBarIndeterminateBackground" Color="{DynamicResource SettingsBorderColor}"/>
                                                </ProgressBar.Resources>
                                            </ProgressBar></Grid>
                                            <Border x:Name="FeedbackStatus" Background="{DynamicResource SettingsSoftBlueBrush}" CornerRadius="6" Padding="10,10" MinHeight="34" AutomationProperties.Name="{loc:Text '反馈生成状态'}">
                                                <TextBlock x:Name="FeedbackStatusMessage" Text="{loc:Text '仅在点击“生成反馈包”后创建本地文件，不会自动上传。'}" Style="{StaticResource SettingsDescriptionStyle}" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource SettingsBlueBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="HelpDetail" Visibility="Collapsed"/>
                                    </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsFooter" Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="FooterNavigationColumn" Width="264" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,1,0,0" />
            <Border Grid.Column="0" Background="{DynamicResource SettingsNavigationBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,1,0" />
            <StackPanel x:Name="FooterActions" Grid.Column="1" Margin="{StaticResource SettingsPageInset}" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RestoreDefaultsButton" MinWidth="112" Content="{loc:Text '恢复默认值'}" Appearance="Secondary" Click="RestoreDefaults_Click" AutomationProperties.Name="{loc:Text '恢复默认值'}" Style="{StaticResource SettingsButtonStyle}" />
                <ui:Button x:Name="CancelButton" Margin="10,0,0,0" Content="{loc:Text '取消'}" Appearance="Secondary" Click="Cancel_Click" AutomationProperties.Name="{loc:Text '取消设置'}" Style="{StaticResource SettingsButtonStyle}" />
                <ui:Button x:Name="SaveButton"
                           Margin="10,0,0,0"
                           MinWidth="148"
                           Content="{loc:Text '保存设置'}"
                           Appearance="Primary"
                           Background="{DynamicResource PrimaryBrush}"
                           BorderBrush="{DynamicResource PrimaryBrush}"
                           Foreground="{DynamicResource OnAccentBrush}"
                           Click="Save_Click"
                           AutomationProperties.Name="{loc:Text '保存设置'}"
                           Style="{StaticResource SettingsButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
