<ui:FluentWindow x:Class="BlueLink.TrustConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="620" Height="576" ResizeMode="NoResize" ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" UseLayoutRounding="True"
    Background="{DynamicResource SurfaceBrush}" Title="{Binding Title}"
    Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" TextElement.FontFamily="{StaticResource HomeFont}">
        <Grid>
            <Grid Margin="31,23">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                <ScrollViewer Margin="0" ScrollChanged="TrustContent_ScrollChanged" x:Name="TrustContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Height="116" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Image Source="/BlueLink;component/Assets/bluelink-logo.png" Width="44" Height="44"/>
                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource ClientFont20}" FontWeight="Bold" Height="34" LineHeight="32" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,6"/>
                            <Grid Height="26" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding PeerIcon}" Width="20" Height="20"/>
                                <TextBlock Grid.Column="2" Text="{Binding PeerName}" ToolTip="{Binding PeerName}" MaxWidth="508" FontSize="{StaticResource ClientFont16}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel MinHeight="162" Margin="0,12,0,0">
                            <Grid Height="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                                <Image Grid.Column="1" Source="Assets/Figma/security-shield.png" Width="48" Height="48"/>
                                <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TrustStatusText" Text="{Binding StatusText}" TextAlignment="Center" FontWeight="Bold" FontSize="{Binding StatusFontSize}" Height="{Binding StatusLineHeight}" LineHeight="{Binding StatusLineHeight}" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0" Foreground="{DynamicResource BlueBrush}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource ClientFont13}" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Height="104" Margin="0,12,0,0" Background="{DynamicResource PanelF8FAFDBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid Margin="11,0">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SoftBlueBrush}" HorizontalAlignment="Left"><Image Source="Assets/Figma/security-fingerprint.png" Width="26" Height="26"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding FirstFingerprintLabel}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FirstFingerprint}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/>
                                <Border Grid.Row="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SoftBlueBrush}" HorizontalAlignment="Left"><Image Source="Assets/Figma/security-fingerprint.png" Width="26" Height="26"/></Border>
                                <TextBlock x:Name="SecondFingerprintLabel" Grid.Row="1" Grid.Column="1" Text="{Binding SecondFingerprintLabel}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RemoteFingerprint}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <TextBlock MinHeight="{StaticResource ClientControlHeight}" Margin="10,12,10,0" Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ui:Button HorizontalAlignment="Stretch" x:Name="TrustCloseButton" Content="{Binding SecondaryText}" Appearance="Secondary" Click="Close_Click" Height="44" FontSize="{StaticResource ClientFont14}" FontWeight="Medium" CornerRadius="10" Foreground="{DynamicResource BlueBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ui:Button HorizontalAlignment="Stretch" x:Name="TrustPrimaryButton" Grid.Column="2" Content="{Binding PrimaryText}" Appearance="Primary" IsEnabled="{Binding PrimaryEnabled}" Click="Primary_Click" Height="44" FontSize="{StaticResource ClientFont14}" FontWeight="Medium" CornerRadius="10"
                               Background="{DynamicResource BlueBrush}" BorderBrush="{DynamicResource BlueBrush}" Foreground="{DynamicResource OnAccentBrush}">
                        <ui:Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource BrandBlueColor}"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource BrandBlueColor}"/>
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White"/>
                        </ui:Button.Resources>
                    </ui:Button>
                </Grid>
            </Grid>
            <ui:Button x:Name="TrustDismissButton" Width="32" Height="32" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,15,0" CornerRadius="8" Appearance="Transparent" Padding="6" BorderThickness="0" Click="Close_Click" AutomationProperties.Name="{loc:Text '关闭'}" ToolTip="{loc:Text '关闭'}">
                <ui:SymbolIcon Symbol="Dismiss20" FontSize="20" Foreground="{DynamicResource MutedBrush}"/>
            </ui:Button>
        </Grid>
    </Border>
</ui:FluentWindow>
