<Window x:Class="BlueLink.TrustConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="蓝联 · 确认安全连接" Width="520" Height="500"
        Icon="/BlueLink;component/Assets/bluelink.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="/BlueLink;component/Assets/bluelink-logo.png" Width="54" Height="54" Stretch="Uniform"/>
            <StackPanel Margin="14,3,0,0">
                <TextBlock Text="确认安全连接" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock x:Name="PeerNameText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="请在两台设备上核对以下安全代码" Margin="0,22,0,9"
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
        <Border Grid.Row="2" Background="#EAF1FF" CornerRadius="16" Padding="20,14">
            <TextBlock x:Name="SafetyCodeText" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,20,0,14">
            <TextBlock Text="本机身份指纹" FontWeight="SemiBold"/>
            <TextBlock x:Name="LocalFingerprintText" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13"/>
            <TextBlock Text="对端身份指纹" FontWeight="SemiBold"/>
            <TextBlock x:Name="RemoteFingerprintText" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            <TextBlock Text="确认后会在本机固定该设备身份；密钥发生变化时连接将被拒绝。"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="拒绝" Width="104" Click="Reject_Click" Margin="0,0,10,0"/>
            <Button Content="确认并信任" Width="132" Click="Accept_Click" Background="{StaticResource BlueBrush}"
                    Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
