<ui:FluentWindow x:Class="BlueLink.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="蓝联设置"
    Width="1180"
    Height="760"
    MinWidth="1040"
    MinHeight="680"
    Icon="/BlueLink;component/Assets/bluelink.ico"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="#F4F6FA"
    UseLayoutRounding="True"
    PreviewKeyDown="SettingsWindow_PreviewKeyDown"
    Closing="SettingsWindow_Closing"
    Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SettingsWindow.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource SettingsCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="蓝联设置"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Width="30"
                           Height="30"
                           Source="/BlueLink;component/Assets/bluelink-logo.png" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsInkBrush}"
                               Text="蓝联设置" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SettingsNavigationBrush}"
                    BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ui:NavigationView x:Name="SettingsNavigation"
                                   AutomationProperties.Name="设置分类"
                                   Background="Transparent"
                                   IsBackButtonVisible="Collapsed"
                                   IsPaneToggleVisible="False"
                                   IsPaneOpen="True"
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="259"
                                   CompactPaneLength="259"
                                   HeaderVisibility="Collapsed"
                                   AlwaysShowHeader="False">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="GeneralNavigationItem" Content="通用" TargetPageTag="general" IsActive="True" Click="NavigationItem_Click" AutomationProperties.Name="通用" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="ConnectionNavigationItem" Content="连接与设备" TargetPageTag="connection" Click="NavigationItem_Click" AutomationProperties.Name="连接与设备" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Link24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="FilesNavigationItem" Content="文件与存储" TargetPageTag="files" Click="NavigationItem_Click" AutomationProperties.Name="文件与存储" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="PrivacyNavigationItem" Content="隐私与数据" TargetPageTag="privacy" Click="NavigationItem_Click" AutomationProperties.Name="隐私与数据" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Shield24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem x:Name="AboutNavigationItem" Content="关于" TargetPageTag="about" Click="NavigationItem_Click" AutomationProperties.Name="关于" Style="{StaticResource SettingsNavigationItemStyle}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ui:InfoBar x:Name="SaveInfoBar" Grid.Row="0" Margin="30,14,30,0" IsOpen="False" IsClosable="True" AutomationProperties.Name="设置操作状态" />

                <ui:DynamicScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,24,30,24">
                    <Grid>
                        <StackPanel x:Name="GeneralPage" AutomationProperties.Name="通用设置页面">
                            <TextBlock Text="通用" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="启动与窗口" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启动时扫描附近设备" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,0,0" Text="蓝联启动后自动查找附近正在运行蓝联的设备" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ScanStartupToggle" Grid.Column="1" AutomationProperties.Name="启动时扫描附近设备" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,18" Background="{StaticResource SettingsBorderBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="关闭主窗口时" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,18,0" Text="选择继续保持后台会话，或完整退出蓝联" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="CloseBehaviorBox" Grid.Column="1" AutomationProperties.Name="关闭主窗口时" Style="{StaticResource SettingsComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SettingsSoftBlueBrush}"><ui:SymbolIcon Symbol="Info24" FontSize="22" Foreground="{StaticResource SettingsBlueBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="后台会话只影响窗口关闭行为" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Margin="0,4,0,0" Text="选择后台运行时可从系统托盘重新打开蓝联；选择退出时会关闭会话和蓝牙服务。" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ConnectionPage" Visibility="Collapsed" AutomationProperties.Name="连接与设备设置页面">
                            <TextBlock Text="连接与设备" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="连接偏好" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自动连接已信任设备" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,0,0" Text="发现此前已核对安全码的设备后自动尝试连接" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="1" AutomationProperties.Name="自动连接已信任设备" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,18" Background="{StaticResource SettingsBorderBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最大同时连接数" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBlock Margin="0,4,18,0" Text="限制同时保持的蓝牙安全会话数量" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="MaxConnectionsBox" Grid.Column="1" AutomationProperties.Name="最大同时连接数" Style="{StaticResource SettingsComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource SettingsSoftBlueBrush}"><ui:SymbolIcon Symbol="Bluetooth24" FontSize="24" Foreground="{StaticResource SettingsBlueBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="附近设备扫描" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ScanFeedback}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ui:Button x:Name="ScanButton" Grid.Column="2" Content="{Binding ScanActionText}" IsEnabled="{Binding CanScan}" Click="Scan_Click" AutomationProperties.Name="重新扫描附近设备" Style="{StaticResource SettingsButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="信任管理" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,12" Text="移除后，再次连接该设备时需要重新核对安全码。" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <ItemsControl ItemsSource="{Binding Conversations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource SettingsSoftBlueBrush}"><ui:SymbolIcon Symbol="Link24" FontSize="20" Foreground="{StaticResource SettingsBlueBrush}" /></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PeerName}" FontFamily="Microsoft YaHei UI" FontWeight="SemiBold" Foreground="{StaticResource SettingsInkBrush}" />
                                                        <TextBlock Text="{Binding PeerId}" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="{StaticResource SettingsMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="2" Content="移除" Click="ForgetPeer_Click" AutomationProperties.Name="移除信任" Style="{StaticResource SettingsButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="FilesPage" Visibility="Collapsed" AutomationProperties.Name="文件与存储设置页面">
                            <TextBlock Text="文件与存储" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="单文件接收上限" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Margin="0,4,0,0" Text="超过限制的文件将自动拒绝" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="ReceiveLimitToggle" Grid.Column="1" Checked="ReceiveLimit_Changed" Unchecked="ReceiveLimit_Changed" AutomationProperties.Name="启用单文件接收上限" Style="{StaticResource SettingsToggleStyle}" />
                                    </Grid>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="大小上限（MiB）" Style="{StaticResource SettingsLabelStyle}" />
                                        <ui:TextBox x:Name="ReceiveLimitText" Grid.Column="1" AutomationProperties.Name="文件大小上限 MiB" Style="{StaticResource SettingsTextBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="文件保存位置" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="DownloadPathText" TextChanged="DownloadPath_Changed" AutomationProperties.Name="文件保存位置" Style="{StaticResource SettingsTextBoxStyle}" />
                                        <ui:Button Grid.Column="1" Margin="10,0,0,0" Content="更改位置" Click="BrowseDownload_Click" AutomationProperties.Name="更改文件保存位置" Style="{StaticResource SettingsButtonStyle}" />
                                        <ui:Button Grid.Column="2" Margin="10,0,0,0" Content="打开文件夹" Click="OpenDownload_Click" AutomationProperties.Name="打开文件保存位置" Style="{StaticResource SettingsButtonStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="StorageSpaceText" Margin="0,10,0,0" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource SettingsSuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="存储空间使用情况" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock x:Name="StorageUsageText" Margin="0,7,0,14" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <ui:Button Content="清理缩略图缓存" HorizontalAlignment="Left" Click="ClearCache_Click" AutomationProperties.Name="清理缩略图缓存" Style="{StaticResource SettingsButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="自动下载文件" Style="{StaticResource SettingsLabelStyle}" /><ui:ToggleSwitch x:Name="AutoDownloadToggle" Grid.Column="1" AutomationProperties.Name="自动下载文件" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <Border Height="1" Margin="0,16" Background="{StaticResource SettingsBorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="在聊天中显示图片缩略图" Style="{StaticResource SettingsLabelStyle}" /><ui:ToggleSwitch x:Name="ThumbnailsToggle" Grid.Column="1" AutomationProperties.Name="显示图片缩略图" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PrivacyPage" Visibility="Collapsed" AutomationProperties.Name="隐私与数据设置页面">
                            <TextBlock Text="隐私与数据" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="本地记录" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="保存聊天记录" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,0,0" Text="聊天内容只保存在这台电脑" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="SaveChatToggle" Grid.Column="1" AutomationProperties.Name="保存聊天记录" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <Border Height="1" Margin="0,16" Background="{StaticResource SettingsBorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="保存文件传输记录" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,0,0" Text="记录文件名称、状态和本地保存位置" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="SaveTransfersToggle" Grid.Column="1" AutomationProperties.Name="保存文件传输记录" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <Border Height="1" Margin="0,16" Background="{StaticResource SettingsBorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="记录保留期限" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,18,0" Text="到期记录会在应用启动和保存设置时清理" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ComboBox x:Name="RetentionBox" Grid.Column="1" AutomationProperties.Name="记录保留期限" Style="{StaticResource SettingsComboBoxStyle}" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="脱敏诊断日志" Style="{StaticResource SettingsSectionTitleStyle}" /><TextBlock Margin="0,4,0,0" Text="不记录消息内容、文件内容、密钥或安全码" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ui:ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="1" AutomationProperties.Name="启用脱敏诊断日志" Style="{StaticResource SettingsToggleStyle}" /></Grid>
                                    <ui:Button Margin="0,16,0,0" Content="导出脱敏诊断日志" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" AutomationProperties.Name="导出脱敏诊断日志" Style="{StaticResource SettingsButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="本机设备标识" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,0" Text="连接时用于核对设备身份；标识仅在本机生成和保存。" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource SettingsSoftBlueBrush}"><TextBlock Text="{Binding IdentityFingerprint}" FontFamily="Cascadia Mono" FontSize="13" Foreground="{StaticResource SettingsInkBrush}" TextWrapping="Wrap" /></Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="#F2C9C5">
                                <StackPanel>
                                    <TextBlock Text="清除本地记录" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,14" Text="这些操作不会删除 Download 中已接收的用户文件。" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal"><ui:Button Content="清除聊天记录" Appearance="Danger" Click="ClearChat_Click" AutomationProperties.Name="清除聊天记录" Style="{StaticResource SettingsButtonStyle}" /><ui:Button Margin="10,0,0,0" Content="清除传输记录" Appearance="Danger" Click="ClearTransfers_Click" AutomationProperties.Name="清除传输记录" Style="{StaticResource SettingsButtonStyle}" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Visibility="Collapsed" AutomationProperties.Name="关于页面">
                            <TextBlock Text="关于" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="104" Height="104" Source="/BlueLink;component/Assets/bluelink-logo.png" /><StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center"><TextBlock Text="蓝联 BlueLink" FontFamily="Microsoft YaHei UI" FontSize="25" FontWeight="Bold" Foreground="{StaticResource SettingsInkBrush}" /><TextBlock x:Name="ProductVersionText" Margin="0,7,0,0" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource SettingsMutedBrush}" /><TextBlock Margin="0,8,0,0" Text="Bluetooth Only · BTX/1.1 · 端到端加密" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource SettingsBlueBrush}" /></StackPanel></Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="运行环境" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text=".NET 桌面运行时" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock x:Name="RuntimeVersionText" Grid.Column="1" Style="{StaticResource SettingsLabelStyle}" /></Grid>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="进程架构" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock x:Name="RuntimeArchitectureText" Grid.Column="1" Style="{StaticResource SettingsLabelStyle}" /></Grid>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="传输协议" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Grid.Column="1" Text="BTX/1.1" Style="{StaticResource SettingsLabelStyle}" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SettingsSoftBlueBrush}"><ui:SymbolIcon Symbol="Shield24" FontSize="22" Foreground="{StaticResource SettingsBlueBrush}" /></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="消息和文件只通过 Bluetooth 传输" Style="{StaticResource SettingsLabelStyle}" /><TextBlock Margin="0,4,0,0" Text="不依赖云服务器；聊天记录、设置和接收文件保存在你的电脑上。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel></Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ui:DynamicScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource SettingsBorderBrush}" BorderThickness="0,1,0,0" />
            <Border Grid.Column="0" BorderBrush="{StaticResource SettingsBorderBrush}" BorderThickness="0,0,1,0" />
            <StackPanel Grid.Column="1" Margin="30,18" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RestoreDefaultsButton" Content="恢复默认值" Appearance="Secondary" Click="RestoreDefaults_Click" AutomationProperties.Name="恢复默认值" Style="{StaticResource SettingsButtonStyle}" />
                <ui:Button x:Name="CancelButton" Margin="12,0,0,0" Content="取消" Appearance="Secondary" Click="Cancel_Click" AutomationProperties.Name="取消设置" Style="{StaticResource SettingsButtonStyle}" />
                <ui:Button x:Name="SaveButton"
                           Margin="12,0,0,0"
                           Width="112"
                           Content="保存设置"
                           Appearance="Primary"
                           Background="{StaticResource SettingsBlueBrush}"
                           BorderBrush="{StaticResource SettingsBlueBrush}"
                           Foreground="White"
                           Click="Save_Click"
                           AutomationProperties.Name="保存设置"
                           Style="{StaticResource SettingsButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
