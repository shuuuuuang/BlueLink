<ui:FluentWindow x:Class="BlueLink.FileAvailabilityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="520" MinHeight="306" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Title="{loc:Text '无法打开文件'}" FontFamily="{StaticResource HomeFont}"
    Background="{DynamicResource SurfaceBrush}" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None" Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
    </ui:FluentWindow.InputBindings>
    <Border x:Name="FileAvailabilityRoot" Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Border.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed"/>
        </Border.CommandBindings>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>
            <Grid x:Name="FileAvailabilityHeader" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="FileAvailabilityTitle" Text="{loc:Text '无法打开文件'}"
                    FontSize="{StaticResource ClientFont16}" FontWeight="Medium" LineHeight="28" LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="23,0,63,0"/>
                <ui:Button x:Name="FileAvailabilityCloseButton" Width="32" Height="32" MinWidth="0" MinHeight="0"
                    Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Appearance="Transparent" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="6"
                    AutomationProperties.Name="{loc:Text '关闭'}" ToolTip="{loc:Text '关闭'}"
                    Command="ApplicationCommands.Close">
                    <Border Width="20" Height="20" Background="{DynamicResource MutedBrush}">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/BlueLink;component/Assets/Figma/file-availability-close.png" Stretch="Fill"/>
                        </Border.OpacityMask>
                    </Border>
                </ui:Button>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderEEF1F5Brush}"/>
            </Grid>
            <ScrollViewer x:Name="FileAvailabilityScroll" Grid.Row="1"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}">
                        <Setter Property="Padding" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                                <Setter Property="Padding" Value="0,0,14,0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="23,14">
                    <Border x:Name="UnavailableFileCard" Background="{DynamicResource CanvasBrush}"
                        CornerRadius="10" Padding="10" MinHeight="68">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="UnavailableFileIconTile" Width="40" Height="40" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                <Image x:Name="UnavailableFileIcon" Width="24" Height="24" Source="{Binding FileIcon, Converter={StaticResource FileTypeIconConverter}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UnavailableFileName" Text="{Binding FileName}" ToolTip="{Binding FileName}"
                                    FontSize="{StaticResource ClientFont13}" FontWeight="Medium" LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                    Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="UnavailableFileStatus" Text="{loc:Text '本地文件不可用'}"
                                    FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                    Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FileAvailabilityExplanation" Margin="0,12,0,0"
                        Text="{loc:Text '文件尚未下载完成，或已被移动、删除。&#xA;请检查传输状态和保存目录后重试。'}"
                        FontSize="{StaticResource ClientFont13}" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                        Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" x:Name="FileAvailabilityFooter" BorderBrush="{DynamicResource BorderEEF1F5Brush}"
                BorderThickness="0,1,0,0">
                <ui:Button x:Name="FileAvailabilityAcknowledgeButton" Content="{loc:Text '知道了'}"
                    Width="88" Height="36" MinWidth="0" MinHeight="0" Margin="0,0,23,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,0" FontSize="13"
                    FontWeight="Medium" CornerRadius="8" Appearance="Primary"
                    Background="{DynamicResource BlueBrush}" Foreground="{DynamicResource OnAccentBrush}"
                    BorderThickness="0" IsDefault="True" Command="ApplicationCommands.Close"/>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
