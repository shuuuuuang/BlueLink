<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BlueLink</AssemblyName>
    <RootNamespace>BlueLink</RootNamespace>
    <ApplicationIcon>..\..\design\brand\app-icons\windows\bluelink.ico</ApplicationIcon>
    <BlueLinkWpfUiMigrationScope>Full</BlueLinkWpfUiMigrationScope>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\WindowsAppControlChannel.cs" Link="Shared\WindowsAppControlChannel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Figma\*.png" />
    <Resource Include="..\..\shared\file-icons\res\drawable-nodpi\*.png" Link="Assets\FileTypes\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\shared\file-icons\assets\licenses\PhosphorIcons.txt" LogicalName="BlueLink.Assets.Licenses.PhosphorIcons.txt" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\Licenses\*.txt" />
    <EmbeddedResource Include="Localization\en-US.json" LogicalName="BlueLink.Localization.en-US.json" />
    <EmbeddedResource Include="Localization\zh-TW.json" LogicalName="BlueLink.Localization.zh-TW.json" />
    <EmbeddedResource Include="..\..\design\fonts\NotoSansSC-OFL.txt" LogicalName="BlueLink.Assets.Licenses.NotoSansSC.txt" />
    <Content Include="..\..\design\fonts\NotoSansSC-OFL.txt" Link="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\..\design\brand\final\bluelink-final-logo.png">
      <Link>Assets\bluelink-logo.png</Link>
    </Resource>
    <Resource Include="..\..\design\brand\app-icons\windows\bluelink.ico">
      <Link>Assets\bluelink.ico</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\shared\WindowsDialogLayout.cs" Link="Shared\WindowsDialogLayout.cs" /></ItemGroup>
</Project>
