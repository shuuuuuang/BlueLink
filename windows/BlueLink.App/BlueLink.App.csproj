<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BlueLink</AssemblyName>
    <RootNamespace>BlueLink</RootNamespace>
    <ApplicationIcon>..\..\design\brand\app-icons\windows\bluelink.ico</ApplicationIcon>
    <BlueLinkWpfUiMigrationScope>SettingsOnly</BlueLinkWpfUiMigrationScope>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\WindowsAppControlChannel.cs" Link="Shared\WindowsAppControlChannel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\design\brand\final\bluelink-final-logo.png">
      <Link>Assets\bluelink-logo.png</Link>
    </Resource>
    <Resource Include="..\..\design\brand\app-icons\windows\bluelink.ico">
      <Link>Assets\bluelink.ico</Link>
    </Resource>
  </ItemGroup>
</Project>
