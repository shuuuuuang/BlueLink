<ui:FluentWindow x:Class="BlueLink.RemoveTrustedDevicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:BlueLink.Localization"
    Title="{loc:Text '批量移除可信设备'}" Width="560" Height="382" ResizeMode="NoResize" ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    FontFamily="{StaticResource HomeFont}" Background="{DynamicResource SurfaceBrush}" UseLayoutRounding="True"
    PreviewKeyDown="Window_PreviewKeyDown" Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/SettingsWindow.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></ui:FluentWindow.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
            <StackPanel Margin="27,23,27,0"><TextBlock Text="{loc:Text '批量移除可信设备'}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource SettingsInkBrush}" LineHeight="31" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="{Binding Description}" FontSize="13" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,0"/></StackPanel>
            <ui:Button Width="32" Height="32" MinWidth="0" MinHeight="0" CornerRadius="8" Margin="0,17,17,0" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="6" BorderThickness="0" AutomationProperties.Name="{loc:Text '关闭'}" Click="Cancel_Click"><ui:SymbolIcon Symbol="Dismiss20" FontSize="20" Foreground="{DynamicResource SettingsMutedBrush}"/></ui:Button>
            <StackPanel Grid.Row="1" Margin="27,0,27,0">
                <Border Height="142" Background="{DynamicResource PanelF8FAFDBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer x:Name="TrustedPeersScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Peers}" Margin="17,0" AutomationProperties.Name="{loc:Text '即将移除的可信设备'}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="69" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SettingsBorderBrush}" Padding="0,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PeerName}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" Foreground="{DynamicResource SettingsInkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PeerName}"/><TextBlock Text="{Binding PeerId}" FontSize="11" Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PeerId}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="{loc:Text '移除后，再次连接这些设备时需要重新核对安全码。'}" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="27,0,27,0">
                <ui:Button x:Name="RemoveTrustCancelButton" Width="96" Content="{loc:Text '取消'}" Click="Cancel_Click" Style="{StaticResource SettingsButtonStyle}"/>
                <ui:Button x:Name="RemoveTrustConfirmButton" Width="96" Content="{loc:Text '全部移除'}" Click="Remove_Click" Margin="10,0,0,0" Padding="10,0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SettingsDestructiveBrush}" BorderBrush="{DynamicResource SettingsDestructiveBrush}" Style="{StaticResource SettingsButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
