<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Thickness x:Key="SettingsPageInset">12</Thickness>
    <Style x:Key="SettingsPageScrollStyle" TargetType="ScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}">
        <Setter Property="Padding" Value="{StaticResource SettingsPageInset}"/>
        <Style.Triggers>
            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                <Setter Property="Padding" Value="12,12,14,12"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>
    <DrawingImage x:Key="SettingsChevronRight">
        <DrawingImage.Drawing><DrawingGroup>
            <DrawingGroup.OpacityMask><ImageBrush ImageSource="/BlueLink;component/Assets/Figma/settings-chevron-right.png" Stretch="Fill"/></DrawingGroup.OpacityMask>
            <GeometryDrawing Brush="{DynamicResource SettingsMutedBrush}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DataTemplate x:Key="SettingsAboutLinkTemplate">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            <Image Grid.Column="1" Width="20" Height="20" Source="{DynamicResource SettingsChevronRight}"/>
        </Grid>
    </DataTemplate>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource SettingsCardColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource SettingsBorderColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource SettingsSoftBlueColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource SettingsBlueColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource SettingsBlueColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SettingsBlueColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource SettingsBlueColor}"/>

    <DataTemplate x:Key="SettingsPreferenceTemplate">
        <Grid Width="172">
            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="✓" FontSize="{StaticResource ClientFont13}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SettingsBlueBrush}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SettingsRowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,10"/>
        <Setter Property="Background" Value="{DynamicResource SettingsBorderBrush}"/>
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont22}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsInkBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont15}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsInkBrush}" />
    </Style>

    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsInkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsButtonStyle"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsTextBoxStyle"
           TargetType="{x:Type ui:TextBox}"
           BasedOn="{StaticResource BlueLinkUiTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsComboBoxItemStyle"
           TargetType="ComboBoxItem"
           BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="MaxDropDownHeight" Value="260" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
    </Style>

    <Style x:Key="SettingsToggleStyle"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsNavigationItemStyle"
           TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsActive" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsBlueBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsAboutLinkStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource LinkButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsInkBrush}"/>
    </Style>
    <Style x:Key="SettingsHelpTopicStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MouseOverBackground" Value="{DynamicResource SettingsSoftBlueBrush}"/>
        <Setter Property="PressedBackground" Value="{DynamicResource SettingsSoftBlueBrush}"/>
        <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
        <Setter Property="PressedBorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource HomeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}"/>
    </Style>
</ResourceDictionary>
