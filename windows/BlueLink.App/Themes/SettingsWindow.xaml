<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="SettingsNavigationBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="SettingsCanvasBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#D9E2F0" />
    <SolidColorBrush x:Key="SettingsInkBrush" Color="#14213A" />
    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#75829A" />
    <SolidColorBrush x:Key="SettingsBlueBrush" Color="#0878D1" />
    <SolidColorBrush x:Key="SettingsSoftBlueBrush" Color="#EDF5FF" />
    <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#18A56A" />
    <SolidColorBrush x:Key="SettingsDangerBrush" Color="#D92D20" />

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SettingsInkBrush}" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SettingsInkBrush}" />
    </Style>

    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SettingsInkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsButtonStyle"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsTextBoxStyle"
           TargetType="{x:Type ui:TextBox}"
           BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MaxDropDownHeight" Value="260" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SettingsToggleStyle"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsNavigationItemStyle"
           TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
