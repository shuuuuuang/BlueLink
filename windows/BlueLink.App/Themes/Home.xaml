<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:BlueLink">
    <local:HomePeerSelectionConverter x:Key="HomePeerSelection"/>
    <FontFamily x:Key="HomeFont">/BlueLink;component/Assets/Fonts/#Noto Sans SC</FontFamily>
    <BitmapImage x:Key="HomeMessageSelectedIcon" UriSource="/BlueLink;component/Assets/Figma/message-selected.png"/>
    <BitmapImage x:Key="HomeFileSelectedIcon" UriSource="/BlueLink;component/Assets/Figma/file.png"/>
    <Style x:Key="HomeSendButton" TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="MouseOverBackground" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="PressedBackground" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="PressedBorderBrush" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="PressedForeground" Value="{DynamicResource OnAccentBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource PanelF8FAFDBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HomeOfflineSendButton" TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource BrandBlueColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource BrandBlueColor}"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White"/>
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Opacity" Value="0.65"/>
    </Style>
    <Style x:Key="HomeIconButton" TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style x:Key="HomeGroupButton" TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="HomeViewButton" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}"/>
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="HomeEmptyGroup">
        <Grid Height="48">
            <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource PanelF8FAFDBrush}" Stroke="{DynamicResource BorderD1D9E5Brush}" StrokeDashArray="3,3"/>
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PanelF1F4F9Brush}">
                    <Image Source="/BlueLink;component/Assets/Figma/generic.png" Width="20" Height="20"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0" Foreground="{DynamicResource Text5E6B85Brush}"
                           FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
