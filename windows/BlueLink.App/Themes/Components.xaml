<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BlueLink"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
        <local:MessageSearchDateMarkerConverter x:Key="DateMarkerVisibility"/>
        <Style x:Key="RecordCalendarDay" TargetType="CalendarDayButton" BasedOn="{StaticResource DefaultCalendarDayButtonStyle}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Grid Width="18" Height="24">
                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <Ellipse x:Name="RecordDateMarker" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource BlueBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsToday, RelativeSource={RelativeSource AncestorType=CalendarDayButton}}" Value="True"><Setter Property="Fill" Value="{DynamicResource OnAccentBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        <Ellipse.Visibility><MultiBinding Converter="{StaticResource DateMarkerVisibility}">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=CalendarDayButton}"/>
                            <Binding Path="DataContext.MatchingDates" RelativeSource="{RelativeSource AncestorType=Calendar}"/>
                        </MultiBinding></Ellipse.Visibility>
                    </Ellipse>
                </Grid>
            </DataTemplate></Setter.Value></Setter>

        </Style>
    <!-- Product composition styles only; base templates come from WPF UI. -->
    <!-- Suppress focus adorners without changing keyboard focus or selection. -->
    <x:Null x:Key="DefaultControlFocusVisualStyle"/>
    <x:Null x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"/>
    <!-- WPF UI overlays scrollbars; allocate a lane only while the bar is visible. -->
    <Style x:Key="ContentScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource UiScrollViewer}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Style.Triggers>
            <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Visible">
                <Setter Property="Padding" Value="0,0,0,14" />
            </Trigger>
            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                <Setter Property="Padding" Value="0,0,14,0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ComputedVerticalScrollBarVisibility" Value="Visible" />
                    <Condition Property="ComputedHorizontalScrollBarVisibility" Value="Visible" />
                </MultiTrigger.Conditions>
                <Setter Property="Padding" Value="0,0,14,14" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}" />
    <Style TargetType="ui:PassiveScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}" />
    <Style x:Key="BlueLinkUiButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}"/>
    <Style x:Key="LinkButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BlueLinkUiButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MouseOverBackground" Value="Transparent"/>
        <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
        <Setter Property="PressedBackground" Value="Transparent"/>
        <Setter Property="PressedBorderBrush" Value="Transparent"/>
    </Style>
    <Style TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ClientFont20}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ClientFont15}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border11000000Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
    </Style>
    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}" />
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource BlueBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource SoftDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderF6C7C3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="10" />
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="DeviceConnectButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="ComposerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="ComposerSendButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderC8D9FABrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource BlueBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BlueLinkUiTextBoxStyle" TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
        <!-- Compact single-line fields need the full line box, not the default 15 DIP vertical padding. -->
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ui:TextBox" BasedOn="{StaticResource BlueLinkUiTextBoxStyle}"/>
    <Style x:Key="BlueLinkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource BlueBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BlueLinkTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ComposerControlHeight}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource BlueLinkTextBoxStyle}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="BlueLinkComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="Height" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ClientControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BlueLinkComboBoxItemStyle}" />
    </Style>
    <Style x:Key="TransparentListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BlueLinkContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="{DynamicResource HomeFont}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="BlueLinkMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource ClientFont13}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers><Trigger Property="CommandParameter" Value="danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="BlueLinkMenuSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelE4E9F2Brush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="{x:Type ui:TitleBar}" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
