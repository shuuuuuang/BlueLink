<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Compact desktop composition; font and control sizes are WPF DIPs. -->
    <sys:Double x:Key="ClientFont13">13</sys:Double>
    <sys:Double x:Key="ClientFont14">14</sys:Double>
    <sys:Double x:Key="ClientFont15">15</sys:Double>
    <sys:Double x:Key="ClientFont16">16</sys:Double>
    <sys:Double x:Key="ClientFont18">18</sys:Double>
    <sys:Double x:Key="ClientFont20">20</sys:Double>
    <sys:Double x:Key="ClientFont22">22</sys:Double>
    <sys:Double x:Key="ClientFont24">24</sys:Double>
    <sys:Double x:Key="ClientFont28">28</sys:Double>
    <sys:Double x:Key="ClientControlHeight">32</sys:Double>
    <Color x:Key="BrandBlueColor">#176BFF</Color>
    <Color x:Key="BrandCyanColor">#12C8E8</Color>
    <Color x:Key="InkColor">#162033</Color>
    <Color x:Key="MutedColor">#687386</Color>
    <Color x:Key="CanvasColor">#F5F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="LavenderColor">#F0ECFF</Color>
    <Color x:Key="SuccessColor">#13A663</Color>
    <Color x:Key="WarningColor">#B06A00</Color>
    <Color x:Key="DangerColor">#D92D20</Color>
    <Color x:Key="BorderColor">#DCE3EF</Color>
    <Color x:Key="SoftBlueColor">#EAF1FF</Color>
    <Color x:Key="SoftGreenColor">#E7F8EF</Color>
    <Color x:Key="SoftWarningColor">#FFF4E5</Color>
    <Color x:Key="SoftDangerColor">#FDECEC</Color>

    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource BrandBlueColor}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{DynamicResource BrandCyanColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="LavenderBrush" Color="{DynamicResource LavenderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBlueBrush" Color="{DynamicResource SoftBlueColor}"/>
    <SolidColorBrush x:Key="SoftGreenBrush" Color="{DynamicResource SoftGreenColor}"/>
    <SolidColorBrush x:Key="SoftWarningBrush" Color="{DynamicResource SoftWarningColor}"/>
    <SolidColorBrush x:Key="SoftDangerBrush" Color="{DynamicResource SoftDangerColor}"/>

    <sys:Double x:Key="RadiusSmall">10</sys:Double>
    <sys:Double x:Key="RadiusMedium">14</sys:Double>
    <sys:Double x:Key="RadiusLarge">20</sys:Double>
    <sys:Double x:Key="HeaderHeight">64</sys:Double>
    <sys:Double x:Key="HeaderLogoSize">48</sys:Double>
    <sys:Double x:Key="ComposerControlHeight">32</sys:Double>
    <sys:Double x:Key="TransferPanelExpandedWidth">326</sys:Double>
    <sys:Double x:Key="TransferPanelCollapsedWidth">52</sys:Double>
    <sys:Double x:Key="TransferPanelExpandedGap">16</sys:Double>
    <sys:Double x:Key="TransferPanelCollapsedGap">8</sys:Double>

    <DropShadowEffect x:Key="PanelShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#22304A"/>
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="18" ShadowDepth="5" Opacity="0.13" Color="#263653"/>
</ResourceDictionary>
