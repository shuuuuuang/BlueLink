<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="BrandBlueColor">#176BFF</Color>
    <Color x:Key="BrandCyanColor">#12C8E8</Color>
    <Color x:Key="InkColor">#162033</Color>
    <Color x:Key="MutedColor">#687386</Color>
    <Color x:Key="CanvasColor">#F5F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="LavenderColor">#F0ECFF</Color>
    <Color x:Key="SuccessColor">#13A663</Color>
    <Color x:Key="WarningColor">#B06A00</Color>
    <Color x:Key="DangerColor">#D92D20</Color>
    <Color x:Key="BorderColor">#DCE3EF</Color>
    <Color x:Key="SoftBlueColor">#EAF1FF</Color>
    <Color x:Key="SoftGreenColor">#E7F8EF</Color>
    <Color x:Key="SoftWarningColor">#FFF4E5</Color>
    <Color x:Key="SoftDangerColor">#FDECEC</Color>

    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BrandBlueColor}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource BrandCyanColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBlueBrush" Color="{StaticResource SoftBlueColor}"/>
    <SolidColorBrush x:Key="SoftGreenBrush" Color="{StaticResource SoftGreenColor}"/>
    <SolidColorBrush x:Key="SoftWarningBrush" Color="{StaticResource SoftWarningColor}"/>
    <SolidColorBrush x:Key="SoftDangerBrush" Color="{StaticResource SoftDangerColor}"/>

    <sys:Double x:Key="RadiusSmall">10</sys:Double>
    <sys:Double x:Key="RadiusMedium">14</sys:Double>
    <sys:Double x:Key="RadiusLarge">20</sys:Double>
    <sys:Double x:Key="HeaderHeight">64</sys:Double>
    <sys:Double x:Key="HeaderLogoSize">48</sys:Double>
    <sys:Double x:Key="ComposerControlHeight">42</sys:Double>
    <sys:Double x:Key="TransferPanelExpandedWidth">326</sys:Double>
    <sys:Double x:Key="TransferPanelCollapsedWidth">52</sys:Double>
    <sys:Double x:Key="TransferPanelExpandedGap">16</sys:Double>
    <sys:Double x:Key="TransferPanelCollapsedGap">8</sys:Double>

    <DropShadowEffect x:Key="PanelShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#22304A"/>
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="18" ShadowDepth="5" Opacity="0.13" Color="#263653"/>
</ResourceDictionary>
