                        <Border Grid.Row="1" Background="{DynamicResource SoftBlueBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,12" Visibility="{Binding ShowOfflineHistoryNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource MutedBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:Text '设备当前离线'}" Foreground="{DynamicResource InkBrush}" FontWeight="Medium" FontSize="13" Margin="0,0,22,0"/>
                                <TextBlock Text="{loc:Text '历史消息和文件仍可浏览；重新连接后即可继续发送'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource SoftBlueBrush}" CornerRadius="12" Padding="10,9" Margin="0,0,0,10" Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Width="34" Height="4" IsIndeterminate="True" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{loc:Text '正在自动建立加密连接'}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Text '取消'}" Click="CancelConnection_Click" Padding="13,0" IsEnabled="{Binding CanCancelConnection}"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding MessagesView}" ItemTemplate="{StaticResource MessageTemplate}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource TransparentListItemStyle}">
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="Transparent"/>
                                    </Style.Resources>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelEDF1F7Brush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,8,0,10">
                                                <TextBlock Text="{Binding Items[0].GroupTimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        <ui:Button x:Name="NewMessagesButton" Grid.Row="2" Visibility="Collapsed" Content="{loc:Text '有新消息  ↓'}" Click="NewMessages_Click" Style="{StaticResource BlueLinkUiButtonStyle}" Appearance="Primary" Background="{DynamicResource BlueBrush}" BorderBrush="{DynamicResource BlueBrush}" Foreground="{DynamicResource OnAccentBrush}" CornerRadius="19" Width="136" Height="{StaticResource ClientControlHeight}" MinHeight="{StaticResource ClientControlHeight}" FontSize="{StaticResource ClientFont13}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="0">
                            <ui:Button.Effect><DropShadowEffect Color="#0D2652" BlurRadius="16" ShadowDepth="6" Opacity="0.22"/></ui:Button.Effect>
                        </ui:Button>

                        <Border x:Name="MessageComposer" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Height="120" Margin="-14,0" BorderBrush="{DynamicResource BorderEEF1F5Brush}" BorderThickness="0,1,0,0" Padding="14,15,14,19">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,10">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                    <ui:TextBox x:Name="MessageInput" PlaceholderText="{Binding ComposerPlaceholder}" IsEnabled="{Binding IsConnected}" BorderThickness="0" Background="Transparent" Padding="2,0" FontSize="{StaticResource ClientFont13}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" MaxLength="16000" KeyDown="MessageInput_KeyDown" AutomationProperties.Name="{loc:Text '消息输入框'}">
                                        <ui:TextBox.Resources>
                                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                        </ui:TextBox.Resources>
                                    </ui:TextBox>
                                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                        <ui:Button Click="File_Click" IsEnabled="{Binding IsConnected}" Width="32" Height="32" MinHeight="0" Padding="6" Appearance="Transparent" ToolTip="{loc:Text '发送文件'}" AutomationProperties.Name="{loc:Text '发送文件'}"><Image Source="{DynamicResource FigmaIcon-attachment}" Width="20" Height="20"/></ui:Button>
                                        <TextBlock Grid.Column="1" Text="{Binding ComposerHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="2" Content="{loc:Text '发送'}" Click="Send_Click" IsEnabled="{Binding IsConnected}" Height="{StaticResource ClientControlHeight}" CornerRadius="10" AutomationProperties.Name="{loc:Text '发送'}">
                                            <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource HomeSendButton}"><Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowOfflineSend}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style></ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Grid.Column="2" Content="{loc:Text '离线'}" IsEnabled="False" Height="{StaticResource ClientControlHeight}" CornerRadius="10" Style="{StaticResource HomeOfflineSendButton}"
                                                   Visibility="{Binding ShowOfflineSend, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{loc:Text '离线'}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsConversationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource SoftBlueBrush}" HorizontalAlignment="Center"><Image Source="/BlueLink;component/Assets/Figma/message-empty.png" Width="32" Height="32"/></Border>
                            <TextBlock Text="{loc:Text '暂无消息'}" FontSize="{StaticResource ClientFont20}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding EmptyConversationHint}" FontSize="{StaticResource ClientFont14}" Foreground="{DynamicResource MutedBrush}" Margin="14,10,14,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600"/>
                        </StackPanel>
                        <Grid x:Name="FileDropOverlay" Grid.RowSpan="4" Panel.ZIndex="30" Visibility="Collapsed" IsHitTestVisible="False" Margin="-14,0" Background="{DynamicResource PanelF8FAFDBrush}">
                            <Rectangle x:Name="FileDropOutline" Fill="{DynamicResource SoftBlueBrush}" Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeDashArray="3,3" RadiusX="14" RadiusY="14" Margin="12"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="FileDropIcon" Source="{DynamicResource FigmaIcon-drop-send}" Width="54" Height="54" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FileDropTitle" Text="{loc:Text '释放以发送文件'}" Margin="14,16,14,0" FontSize="{StaticResource ClientFont22}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FileDropDetail" Text="{loc:Text '文件将通过当前加密会话传输'}" Margin="14,10,14,0" FontSize="{StaticResource ClientFont14}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="TransferPanel" Grid.Row="2" Visibility="{Binding ShowFiles, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource PanelF5F7FBBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                    <Border x:Name="FullTransferContent" Background="{DynamicResource SurfaceBrush}" Padding="12,10">
                        <Grid x:Name="FileToolbar" SizeChanged="FileToolbar_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="FileStatusFilters" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="{loc:Text '全部状态'}" Tag="All" GroupName="TransferFilter" IsChecked="True" Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,4,0"/>
                                <RadioButton Content="{loc:Text '进行中'}" Tag="Active" GroupName="TransferFilter" Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,4,0"/>
                                <RadioButton Content="{loc:Text '完成'}" Tag="Completed" GroupName="TransferFilter" Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,4,0"/>
                                <RadioButton Content="{loc:Text '失败'}" Tag="Failed" GroupName="TransferFilter" Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="FileStatusFilter" FontSize="12" Width="140" Height="{StaticResource ClientControlHeight}" Visibility="Collapsed" SelectedValuePath="Tag" SelectedValue="All" SelectionChanged="FileStatus_Changed" AutomationProperties.Name="{loc:Text '文件状态'}">
                                <ComboBoxItem Content="{loc:Text '全部状态'}" Tag="All"/><ComboBoxItem Content="{loc:Text '进行中'}" Tag="Active"/><ComboBoxItem Content="{loc:Text '完成'}" Tag="Completed"/><ComboBoxItem Content="{loc:Text '失败'}" Tag="Failed"/>
                            </ComboBox>
                            <Border x:Name="FileSearchHost" Grid.Column="1" Margin="10,0,10,0" MinWidth="184" Height="{StaticResource ClientControlHeight}" CornerRadius="8">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FileSearchActiveBorderBrush}"/><Setter Property="BorderThickness" Value="1.5"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FileSearchActiveBorderBrush}"/><Setter Property="BorderThickness" Value="1.5"/></Trigger></Style.Triggers></Style></Border.Style>
                                <Grid>
                                    <ui:TextBox x:Name="FileSearchInput" IconPlacement="Right" MinHeight="0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="{StaticResource ClientFont13}" PlaceholderText="{loc:Text '搜索文件名'}" AutomationProperties.Name="{loc:Text '搜索文件名'}" TextChanged="FileQuery_Changed">
                                        <ui:TextBox.Resources><SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent"/></ui:TextBox.Resources>
                                        <ui:TextBox.Icon><ui:ImageIcon Width="22" Height="22"><ui:ImageIcon.Style><Style TargetType="ui:ImageIcon"><Setter Property="Source" Value="{DynamicResource FigmaIcon-search}"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=FileSearchHost}" Value="True"><Setter Property="Source" Value="{DynamicResource FigmaIcon-search-active}"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=FileSearchHost}" Value="True"><Setter Property="Source" Value="{DynamicResource FigmaIcon-search-active}"/></DataTrigger></Style.Triggers></Style></ui:ImageIcon.Style></ui:ImageIcon></ui:TextBox.Icon>
                                    </ui:TextBox>
                                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Right" Margin="0,0,36,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ComboBox x:Name="FileDeviceFilter" FontSize="12" Grid.Column="2" Height="{StaticResource ClientControlHeight}" Margin="0,0,10,0" SelectionChanged="FileDevice_Changed" DropDownOpened="FileDevices_Opened" AutomationProperties.Name="{loc:Text '文件设备范围'}"/>
                            <ComboBox x:Name="FileDirectionFilter" FontSize="12" Grid.Column="3" Height="{StaticResource ClientControlHeight}" SelectedIndex="0" SelectionChanged="FileDirection_Changed" AutomationProperties.Name="{loc:Text '文件传输方向'}"><ComboBoxItem Content="{loc:Text '全部方向'}" Tag="All"/><ComboBoxItem Content="{loc:Text '发送'}" Tag="Outgoing"/><ComboBoxItem Content="{loc:Text '接收'}" Tag="Incoming"/></ComboBox>
                        </Grid>
                    </Border>
                    <Border x:Name="FileColumnsHeaderBackground" Grid.Row="1" Background="{DynamicResource PanelF8FAFDBrush}">
                    <Grid x:Name="FileColumnsHeader" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text '文件名'}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{loc:Text '大小'}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:Text '来源 → 目标'}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{loc:Text '状态'}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{loc:Text '进度'}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{loc:Text '操作'}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{loc:Text '时间'}" VerticalAlignment="Center"/>
                        <Grid.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style></Grid.Resources>
                    </Grid>
                    </Border>
                    <ListBox x:Name="TransferList" Grid.Row="2" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="TransferList_ScrollChanged">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource TransparentListItemStyle}"><EventSetter Event="Loaded" Handler="TransferRow_Loaded"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle><GroupStyle>
                            <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><EventSetter Event="Loaded" Handler="TransferGroup_Loaded"/></Style></GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate><DataTemplate>
                            <ToggleButton IsChecked="True" Click="TransferGroup_Click" Height="36" Background="{DynamicResource PanelF8FAFDBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderEEF1F5Brush}" Padding="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="FileGroupChevron" Source="{DynamicResource FigmaIcon-chevron}" Width="16" Height="16" RenderTransformOrigin="0.5,0.5"><Image.Style><Style TargetType="Image"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Name}" Margin="8,0"/><TextBlock Text="{Binding ItemCount, StringFormat={}({0})}"/></StackPanel>
                            </ToggleButton>
                        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border x:Name="FileTableRow" MinHeight="46" Padding="12,9" CornerRadius="0">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderEEF1F5Brush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedFileRowBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Border.ContextMenu><ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}" Opened="FileContextMenu_Opened">
<MenuItem Tag="open" Click="TransferOpenMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-open}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="copy" Click="TransferCopy_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-copy}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="locate" Click="TransferLocateMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-folder}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="save" Click="TransferSaveAsMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-download}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="info" Click="TransferInfoMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-details}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="pause" Click="PauseTransfer_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-pause}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="resume" Click="ResumeTransfer_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-play}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="retry" Click="RetryTransfer_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-play}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<Separator Tag="active" Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
<MenuItem Tag="cancel" Click="CancelTransfer_Click" Style="{StaticResource BlueLinkMenuItemStyle}" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-cancel}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="failure" Click="TransferFailure_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-alert}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<Separator Tag="terminal" Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
<MenuItem Tag="delete" Click="TransferDeleteMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-trash}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
</ContextMenu></Border.ContextMenu>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding FileIcon, Converter={StaticResource FileTypeIconConverter}}" RenderOptions.BitmapScalingMode="HighQuality" Width="20" Height="20"/><TextBlock Grid.Column="1" local:HighlightedText.Text="{Binding Name}" local:HighlightedText.Query="{Binding DataContext.FileSearchQuery, RelativeSource={RelativeSource AncestorType=ListBox}}" local:HighlightedText.Brush="{DynamicResource BlueBrush}" ToolTip="{Binding Name}" Margin="8,0,10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RouteText}" ToolTip="{Binding RouteText}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding Progress, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="{loc:Text '打开'}" Click="TransferOpen_Click" Appearance="Transparent" Padding="0" MinHeight="28" Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource BlueBrush}" Style="{StaticResource LinkButtonStyle}"/>
                                    <ui:Button Click="PauseTransfer_Click" Appearance="Transparent" Padding="3" Width="28" Height="28" MinHeight="0" ToolTip="{Binding PauseActionText}" AutomationProperties.Name="{Binding PauseActionText}" Visibility="{Binding ShowPauseAction, Converter={StaticResource BooleanToVisibilityConverter}}"><Image Source="{DynamicResource FigmaIcon-pause}" Width="20" Height="20"/></ui:Button>
                                    <ui:Button Content="{loc:Text '继续'}" Click="ResumeTransfer_Click" Appearance="Transparent" Padding="0" MinHeight="28" Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource LinkButtonStyle}"/>
                                    <ui:Button Content="{loc:Text '重试'}" Click="RetryTransfer_Click" Appearance="Transparent" Padding="0" MinHeight="28" Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource LinkButtonStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding TimeText}" VerticalAlignment="Center"/>
                                <Grid.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style></Grid.Resources>
                            </Grid>
                        </Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="FileEmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                        <Border x:Name="FileEmptyIconBackground" Width="72" Height="72" CornerRadius="36" Background="{DynamicResource SoftBlueBrush}" HorizontalAlignment="Center"><Image x:Name="FileEmptyIcon" Source="{DynamicResource FigmaIcon-file-empty}" Width="32" Height="32"/></Border>
                        <TextBlock x:Name="FileEmptyText" Text="{loc:Text '暂无文件记录'}" FontSize="{StaticResource ClientFont20}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" Margin="0,14,0,0"/>
                        <TextBlock x:Name="FileEmptyDetail" Text="{loc:Text '通过消息发送或接收文件后，记录会显示在这里。'}" FontSize="{StaticResource ClientFont14}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600"/>
                    </StackPanel>
                    <Border x:Name="FileFooter" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderEEF1F5Brush}" BorderThickness="0,1,0,0" Padding="12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReceiveDirectoryLabel" Text="{loc:Text '接收目录：'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ReceiveDirectoryPath" Grid.Column="1" Text="{Binding Settings.DownloadDirectory}" ToolTip="{Binding Settings.DownloadDirectory}" MaxWidth="360" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <ui:Button x:Name="ChangeReceiveDirectoryButton" Grid.Column="2" Content="{loc:Text '更改'}" Appearance="Transparent" Click="ChangeReceiveDirectory_Click" Padding="10,0" MinHeight="28" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}"/>
                            </Grid>
                            <TextBlock x:Name="FileCountText" Grid.Column="1" Text="{loc:Text '0 个文件'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding ShowConversationPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="309*"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="479*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource SoftBlueBrush}" HorizontalAlignment="Center">
                            <Image Source="/BlueLink;component/Assets/Figma/conversation-empty.png" Width="32" Height="32"/>
                        </Border>
                        <TextBlock Text="{loc:Text '选择设备开始会话'}" FontSize="{StaticResource ClientFont20}" FontWeight="Bold" TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="{loc:Text '从左侧选择设备，即可查看历史消息和文件。'}" FontSize="{StaticResource ClientFont14}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="14,10,14,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <ContentControl x:Name="SettingsHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <local:ToastHost x:Name="Toasts" Grid.RowSpan="2" Margin="12,72,12,0" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="100"/>
    </Grid>
</ui:FluentWindow>
