<Window x:Class="BlueLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:BlueLink.Domain"
        Title="蓝联 / BlueLink" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Icon="/BlueLink;component/Assets/bluelink.ico"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ConversationListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#F8FAFD" BorderBrush="#E6EBF3" BorderThickness="1"
                                CornerRadius="16" Padding="13" Margin="0,0,0,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#F1F6FF"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C8D9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource LavenderBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A9BEF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ConversationCardTemplate" DataType="{x:Type domain:ConversationSummary}">
            <Grid ToolTip="{Binding PeerId}">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="打开会话" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationOpenMenu_Click"/>
                        <MenuItem Header="连接设备" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationConnectMenu_Click"
                                  Visibility="{Binding IsConnectable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <MenuItem Header="断开连接" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationDisconnectMenu_Click"
                                  Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <MenuItem Header="查看设备信息" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationInfoMenu_Click"/>
                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                        <MenuItem Header="清空此会话记录…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationClearMenu_Click"/>
                        <MenuItem Header="移除信任…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationForgetMenu_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="11"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource SoftBlueBrush}">
                    <Path x:Name="PlatformIcon" Data="{StaticResource IconDesktop}" Fill="{StaticResource BlueBrush}"
                          Stretch="Uniform" Width="22" Height="22"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeerName}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"
                               FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#AAB3C2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastSeenText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="UnreadBadge" Grid.Column="3" Background="{StaticResource BlueBrush}" CornerRadius="11"
                        MinWidth="22" Height="22" Padding="6,0" Margin="7,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Platform}" Value="{x:Static domain:PeerPlatform.Android}">
                    <Setter TargetName="PlatformIcon" Property="Data" Value="{StaticResource IconPhone}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="{x:Static domain:DeviceAvailability.Connected}">
                    <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="{x:Static domain:DeviceAvailability.Connectable}">
                    <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource BlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AttachmentTemplate" DataType="{x:Type domain:ChatAttachment}">
            <Button Click="Attachment_Click"
                    PreviewMouseLeftButtonDown="Attachment_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Attachment_PreviewMouseMove"
                    Padding="0" Margin="0,7,0,0" HorizontalContentAlignment="Stretch"
                    BorderThickness="0" Background="Transparent">
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="预览或打开" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentOpenMenu_Click"/>
                        <MenuItem Header="在资源管理器中显示" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentLocateMenu_Click"/>
                        <MenuItem Header="另存为…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentSaveAsMenu_Click"/>
                        <MenuItem Header="复制文件" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentCopyMenu_Click"/>
                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                        <MenuItem Header="查看文件详情" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentInfoMenu_Click"/>
                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                        <MenuItem Header="删除本机记录…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="AttachmentDeleteMenu_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Background="White" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Image x:Name="Thumbnail" Source="{Binding Converter={StaticResource AttachmentThumbnailConverter}}"
                               MaxWidth="320" MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Center"
                               SnapsToDevicePixels="True" Visibility="Collapsed"/>
                        <Grid x:Name="FileCard" Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource SoftBlueBrush}">
                                <Path Data="{StaticResource IconFile}" Fill="{StaticResource BlueBrush}" Width="20" Height="22" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{StaticResource BlueBrush}"
                                       FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="ImageCaption" Grid.Row="1" Margin="12,9,12,11" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{StaticResource BlueBrush}"
                                       FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <ProgressBar Grid.Row="2" Height="4" Margin="12,0,12,10" Minimum="0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource BlueBrush}"
                                     Visibility="{Binding IsTransferActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsImage}" Value="True"/>
                        <Condition Binding="{Binding DataContext.Settings.ShowImageThumbnails, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Thumbnail" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FileCard" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageCaption" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type domain:ChatItem}">
            <Grid Margin="4,3,4,8">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="复制消息" Style="{StaticResource BlueLinkMenuItemStyle}" Click="MessageCopyMenu_Click"/>
                        <MenuItem Header="查看消息详情" Style="{StaticResource BlueLinkMenuItemStyle}" Click="MessageInfoMenu_Click"/>
                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                        <MenuItem Header="删除本机记录…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="MessageDeleteMenu_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="570" MinWidth="92"
                        Background="#F1F4F9" CornerRadius="18,18,18,5" Padding="13,11">
                    <StackPanel>
                        <TextBlock x:Name="MessageText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                   Foreground="{StaticResource InkBrush}"
                                   Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentTemplate}"/>
                        <TextBlock x:Name="MessageMeta" Text="{Binding MetaText}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" HorizontalAlignment="Right" Margin="8,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outgoing}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BlueBrush}"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="18,18,5,18"/>
                    <Setter TargetName="MessageText" Property="Foreground" Value="White"/>
                    <Setter TargetName="MessageMeta" Property="Foreground" Value="#DDE8FF"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}" Margin="30,14,30,22">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="{StaticResource HeaderLogoSize}" Height="{StaticResource HeaderLogoSize}" Source="/BlueLink;component/Assets/bluelink-logo.png" Stretch="Uniform"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="蓝联" FontWeight="Bold" FontSize="22" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="BLUETOOTH ONLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Settings_Click" Style="{StaticResource CompactToolbarButtonStyle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource InkBrush}" Width="17" Height="17" Stretch="Uniform"/>
                        <TextBlock Text="设置" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Background="{StaticResource SoftGreenBrush}" CornerRadius="19" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveSessionCountText}" Foreground="#24593E" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TransferGapColumn" Width="16"/>
                <ColumnDefinition x:Name="TransferColumn" Width="326"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="设备与会话" Style="{StaticResource PageTitleStyle}" FontSize="21"/>
                        <TextBlock Text="{Binding ActiveSessionCountText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,7"><TextBlock Text="已连接" Style="{StaticResource SectionTitleStyle}" FontSize="14"/><TextBlock Text="后台保持会话" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="10.5"/></Grid>
                            <ListBox ItemsSource="{Binding ConnectedConversations}" ItemTemplate="{StaticResource ConversationCardTemplate}"
                                     ItemContainerStyle="{StaticResource ConversationListItemStyle}" SelectionChanged="Conversation_SelectionChanged"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <Grid Margin="0,10,0,7"><TextBlock Text="离线" Style="{StaticResource SectionTitleStyle}" FontSize="14"/><TextBlock Text="可查看历史" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="10.5"/></Grid>
                            <ListBox ItemsSource="{Binding OfflineConversations}" ItemTemplate="{StaticResource ConversationCardTemplate}"
                                     ItemContainerStyle="{StaticResource ConversationListItemStyle}" SelectionChanged="Conversation_SelectionChanged"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="附近新设备" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,7"/>
                        <ListBox ItemsSource="{Binding NearbyNewDevices}" SelectedItem="{Binding SelectedDevice}" MaxHeight="118" BorderThickness="0"
                                 Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><StaticResource ResourceKey="TransparentListItemStyle"/></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:NearbyDevice}">
                                    <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="11" Margin="0,0,0,7">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SoftBlueBrush}">
                                                <Path Data="{StaticResource IconPhone}" Fill="{StaticResource BlueBrush}" Width="18" Height="20" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CompactPresenceDetail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="连接" Click="ConnectDevice_Click" Style="{StaticResource DeviceConnectButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <Button x:Name="ScanButton" Grid.Row="3" Click="Scan_Click" Margin="0,12,0,0"
                            IsEnabled="{Binding CanScan}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource InkBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="{Binding ScanActionText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="4" Text="{Binding ScanFeedback}" Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="4,7,4,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Padding="18,14,18,14"
                    AllowDrop="True"
                    PreviewDragEnter="ChatSurface_PreviewDragEnter"
                    PreviewDragOver="ChatSurface_PreviewDragOver"
                    PreviewDragLeave="ChatSurface_PreviewDragLeave"
                    PreviewDrop="ChatSurface_PreviewDrop">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource SoftBlueBrush}">
                            <Path Data="{StaticResource IconDesktop}" Fill="{StaticResource BlueBrush}" Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActivePeerTitle}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActivePeerSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource SoftWarningBrush}" CornerRadius="12" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding IsOfflineConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="设备当前离线；历史消息保存在本机，重新连接后继续同步。" Foreground="#8A5700" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource SoftBlueBrush}" CornerRadius="12" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ProgressBar Width="34" Height="4" IsIndeterminate="True" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="正在自动建立加密连接" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="取消" Click="CancelConnection_Click" Padding="13,6"
                                    IsEnabled="{Binding CanCancelConnection}"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding MessagesView}" ItemTemplate="{StaticResource MessageTemplate}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle><StaticResource ResourceKey="TransparentListItemStyle"/></ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#EDF1F7" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,8,0,12">
                                            <TextBlock Text="{Binding Items[0].GroupTimeText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <Button x:Name="NewMessagesButton" Grid.Row="2" Visibility="Collapsed"
                            Content="有新消息  ↓" Click="NewMessages_Click"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="13,7" MinHeight="34"/>
                    <Grid Grid.Row="3" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Click="File_Click" IsEnabled="{Binding IsConnected}" Style="{StaticResource ComposerIconButtonStyle}" ToolTip="发送文件">
                            <Path Data="{StaticResource IconPaperclip}" Fill="{StaticResource InkBrush}" Stretch="Uniform"/>
                        </Button>
                        <Grid Grid.Column="1" Margin="8,0">
                            <TextBox Text="{Binding ComposerPlaceholder, Mode=OneWay}" IsEnabled="False"
                                     Style="{StaticResource ComposerTextBoxStyle}"/>
                            <TextBox x:Name="MessageInput" Style="{StaticResource ComposerTextBoxStyle}" KeyDown="MessageInput_KeyDown"
                                     Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <Button Grid.Column="2" Click="Send_Click" IsEnabled="{Binding IsConnected}" Style="{StaticResource ComposerSendButtonStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="发送"/><Path Data="{StaticResource IconSend}" Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="7,0,0,0"/></StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="FileDropOverlay" Grid.RowSpan="4" Panel.ZIndex="30"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            Background="#EFFFFFFF" BorderBrush="{StaticResource BlueBrush}"
                            BorderThickness="2" CornerRadius="18" Margin="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource SoftBlueBrush}"
                                    HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconPaperclip}" Fill="{StaticResource BlueBrush}"
                                      Width="25" Height="25" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="FileDropTitle" Text="释放以发送文件" Margin="0,16,0,0"
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FileDropDetail" Text="文件将通过当前加密会话传输" Margin="0,7,0,0"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="TransferPanel" Grid.Column="4">
                <Border x:Name="FullTransferContent" Style="{StaticResource PanelCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="文件传输" Style="{StaticResource PageTitleStyle}" FontSize="21"/><TextBlock Text="校验通过后原子落盘" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                            <Button x:Name="TransferPanelToggle" Grid.Column="1" Click="TransferPanelToggle_Click" Style="{StaticResource IconButtonStyle}" ToolTip="收起传输栏">
                                <Path Data="{StaticResource IconChevronRight}" Fill="{StaticResource InkBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="CurrentTransfersTab" Content="当前会话" GroupName="TransferScope"
                                         IsChecked="True" Checked="TransferScope_Changed" HorizontalContentAlignment="Center"
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,4,0"/>
                            <RadioButton x:Name="AllTransfersTab" Grid.Column="1" Content="全部" GroupName="TransferScope"
                                         Checked="TransferScope_Changed" HorizontalContentAlignment="Center"
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Margin="4,0,0,0"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="全部" Tag="All" GroupName="TransferFilter" IsChecked="True"
                                         Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,5,0"/>
                            <RadioButton Content="进行中" Tag="Active" GroupName="TransferFilter"
                                         Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,5,0"/>
                            <RadioButton Content="完成" Tag="Completed" GroupName="TransferFilter"
                                         Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,5,0"/>
                            <RadioButton Content="失败" Tag="Failed" GroupName="TransferFilter"
                                         Checked="TransferFilter_Changed" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                        </StackPanel>
                        <ListBox x:Name="TransferList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle><StaticResource ResourceKey="TransparentListItemStyle"/></ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#EEF4FF" CornerRadius="11" Padding="10,7" Margin="0,3,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Path Data="{StaticResource IconDesktop}" Fill="{StaticResource BlueBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource InkBrush}"
                                                               FontSize="10.5" FontWeight="SemiBold" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ItemCount, StringFormat={}{0} 项}"
                                                               Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:TransferItem}">
                                    <Border Background="#F7F9FC" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="14" Padding="11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ContextMenu>
                                                    <ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="打开" Style="{StaticResource BlueLinkMenuItemStyle}" Click="TransferOpenMenu_Click"
                                                                  IsEnabled="{Binding CanOpen}"/>
                                                        <MenuItem Header="在资源管理器中显示" Style="{StaticResource BlueLinkMenuItemStyle}" Click="TransferLocateMenu_Click"
                                                                  IsEnabled="{Binding CanLocate}"/>
                                                        <MenuItem Header="另存为…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="TransferSaveAsMenu_Click"
                                                                  IsEnabled="{Binding CanLocate}"/>
                                                        <MenuItem Header="查看详情" Style="{StaticResource BlueLinkMenuItemStyle}" Click="TransferInfoMenu_Click"/>
                                                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                                                        <MenuItem Header="删除本机记录…" Style="{StaticResource BlueLinkMenuItemStyle}" Click="TransferDeleteMenu_Click"
                                                                  IsEnabled="{Binding CanDelete}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="62"/><ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource SoftBlueBrush}"><Path Data="{StaticResource IconFile}" Fill="{StaticResource BlueBrush}" Width="17" Height="20" Stretch="Uniform"/></Border>
                                                <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="打开" Click="TransferOpen_Click" Width="58" Height="32" MinHeight="32" Padding="8,4"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Grid.Column="2" Content="重试" Click="RetryTransfer_Click" Width="58" Height="32" MinHeight="32" Padding="8,4"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Grid.Column="3" Content="⋮" Width="30" Height="30" MinHeight="30" Padding="0" Margin="4,0,0,0"
                                                        Click="TransferMore_Click" ToolTip="更多操作"/>
                                            </Grid>
                                            <ProgressBar Grid.Row="1" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,7"/>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="暂停" Click="PauseTransfer_Click" Padding="7,4" MinHeight="0" Margin="0,0,4,0"
                                                            Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Content="继续" Click="ResumeTransfer_Click" Padding="7,4" MinHeight="0" Margin="0,0,4,0"
                                                            Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Content="取消" Click="CancelTransfer_Click" Padding="7,4" MinHeight="0"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding AllTransfers.Count, StringFormat={}{0} 项传输记录}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="CollapsedTransferRail" Visibility="Collapsed" Style="{StaticResource PanelCardStyle}" Padding="5">
                    <Button Click="TransferPanelToggle_Click" ToolTip="展开传输栏" Width="42" Height="100" Padding="0"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel VerticalAlignment="Center">
                            <Path Data="{StaticResource IconChevronLeft}" Fill="{StaticResource InkBrush}"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SoftBlueBrush}" Margin="0,18,0,0">
                                <Grid>
                                    <Path Data="{StaticResource IconTransfers}" Fill="{StaticResource BlueBrush}"
                                          Width="18" Height="18" Stretch="Uniform"/>
                                    <Border Background="{StaticResource BlueBrush}" CornerRadius="8" MinWidth="16" Height="16"
                                            Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                        <TextBlock Text="{Binding AllTransfers.Count}" Foreground="White" FontSize="8.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
