<ui:FluentWindow x:Class="BlueLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:BlueLink.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:BlueLink.Domain"
        xmlns:local="clr-namespace:BlueLink"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Text '蓝联 / BlueLink'}" Width="1180" Height="720" MinWidth="1000" MinHeight="600"
        Icon="/BlueLink;component/Assets/bluelink.ico"
        Background="{DynamicResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" FontFamily="{StaticResource HomeFont}" Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True" PreviewKeyDown="Home_KeyDown"
        Style="{DynamicResource {x:Type ui:FluentWindow}}">
    <ui:FluentWindow.Resources>
        <ContextMenu x:Key="NearbyRefreshMenu" x:Shared="False" MinWidth="190" Style="{StaticResource BlueLinkContextMenuStyle}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem x:Name="RefreshNearbyMenuItem" Header="{Binding RefreshNearbyText}" InputGestureText="F5"
                      IsEnabled="{Binding CanScan}" Click="RefreshNearby_Click"
                      AutomationProperties.AutomationId="RefreshNearbyDevices" AutomationProperties.Name="{Binding RefreshNearbyText}">
                <MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-preview-reset}" Width="18" Height="18"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <local:MessageTimeGapConverter x:Key="MessageTimeGapConverter"/>
        <local:AttachmentSummaryConverter x:Key="AttachmentSummary"/>
        <Style x:Key="ConversationListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource TransparentListItemStyle}">
            <Style.Resources>
                <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="Transparent"/>
            </Style.Resources>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="Margin" Value="0"/></Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ConversationCardTemplate" DataType="{x:Type domain:ConversationSummary}">
            <Border x:Name="ConversationCard" PreviewMouseRightButtonDown="PreserveSelectionOnRightClick"
                    PreviewMouseLeftButtonDown="ConversationCard_PreviewMouseLeftButtonDown" Cursor="Hand"
                    ToolTip="{Binding PeerName}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDCE3EFBrush}"
                    BorderThickness="1"
                    CornerRadius="8" MinHeight="60"
                    Padding="10,10">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Text '打开会话'}" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationOpenMenu_Click"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-message}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="ConversationConnectMenu" Header="{loc:Text '连接设备'}" Click="ConversationConnectMenu_Click"
                                  IsEnabled="{Binding IsConnectable}" AutomationProperties.AutomationId="ConversationConnectMenu">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource BlueLinkMenuItemStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                            <MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-connect-device}" Width="18" Height="18"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:Text '查看设备信息'}" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationInfoMenu_Click"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-info}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                        <Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                        <MenuItem Header="{loc:Text '清空会话记录'}" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationClearMenu_Click" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-trash}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{loc:Text '移除信任'}" Style="{StaticResource BlueLinkMenuItemStyle}" Click="ConversationForgetMenu_Click" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-shieldx}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border x:Name="ConversationIconTile" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SoftBlueBrush}">
  <Grid>
   <Image x:Name="PlatformIcon" Source="/BlueLink;component/Assets/Figma/generic.png" Width="20" Height="20"/>
   <Border x:Name="OfflinePlatformIcon" Width="20" Height="20" Background="{DynamicResource MutedBrush}" Visibility="Collapsed">
    <Border.OpacityMask><ImageBrush ImageSource="{Binding Source, ElementName=PlatformIcon}" Stretch="Uniform"/></Border.OpacityMask>
   </Border>
  </Grid>
 </Border>
 <StackPanel Grid.Column="2" VerticalAlignment="Center">
  <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding PeerName}" Foreground="{DynamicResource InkBrush}" FontWeight="Medium" FontSize="{StaticResource ClientFont13}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Image x:Name="ConversationUsbReady" Grid.Column="1" Source="{DynamicResource FigmaIcon-usb-ready}" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding UsbReady, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{loc:Text 'USB 加速已就绪'}" AutomationProperties.Name="{loc:Text 'USB 加速已就绪'}"/>
  </Grid>
  <TextBlock x:Name="ConversationSecondaryText" Text="{Binding LastSeenText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
  <ProgressBar x:Name="ConversationTransferProgress" Minimum="0" Maximum="1" Value="{Binding ActiveTransfer.Progress, Mode=OneWay}" Height="4" Margin="0,4,0,0" Foreground="{DynamicResource BlueBrush}" Background="{DynamicResource PanelE4E9F2Brush}" Visibility="{Binding HasActiveTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 </StackPanel>
 <Grid Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
  <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{DynamicResource PanelAEB7C6Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  <Border x:Name="UnreadBadge" Background="{DynamicResource BlueBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
   <TextBlock Text="{Binding UnreadText}" Foreground="{DynamicResource OnAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
 </Grid>
</Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                    <Setter TargetName="ConversationCard" Property="Background" Value="{DynamicResource PanelF1F6FFBrush}"/>
                    <Setter TargetName="ConversationCard" Property="BorderBrush" Value="{DynamicResource BorderC8D9FABrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource HomePeerSelection}">
                            <Binding Path="PeerId"/>
                            <Binding Path="DataContext.HighlightedPeerId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="ConversationCard" Property="Background" Value="{DynamicResource SoftBlueBrush}"/>
                    <Setter TargetName="ConversationCard" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="{x:Static domain:PeerPlatform.Windows}"><Setter TargetName="PlatformIcon" Property="Source" Value="/BlueLink;component/Assets/Figma/desktop.png"/></DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="{x:Static domain:PeerPlatform.Android}">
                    <Setter TargetName="PlatformIcon" Property="Source" Value="/BlueLink;component/Assets/Figma/phone.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="{x:Static domain:DeviceAvailability.Connected}">
                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="ConversationIconTile" Property="Background" Value="{DynamicResource PanelF8FAFDBrush}"/>
                    <Setter TargetName="PlatformIcon" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="OfflinePlatformIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsConnected}" Value="False"/>
                        <Condition Value="True"><Condition.Binding>
                            <MultiBinding Converter="{StaticResource HomePeerSelection}">
                                <Binding Path="PeerId"/>
                                <Binding Path="DataContext.HighlightedPeerId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Condition.Binding></Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConversationCard" Property="Background" Value="{DynamicResource OfflineSelectedBrush}"/>
                    <Setter TargetName="ConversationCard" Property="BorderBrush" Value="{DynamicResource OfflineSelectedBorderBrush}"/>
                    <Setter TargetName="ConversationCard" Property="BorderThickness" Value="1.5"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasActiveTransfer}" Value="True"><Setter TargetName="ConversationCard" Property="MinHeight" Value="72"/><Setter TargetName="ConversationSecondaryText" Property="Text" Value="{Binding ActiveTransfer.DeviceStatusText}"/></DataTrigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=ConversationCard}" Value="True"><Setter TargetName="ConversationCard" Property="Background" Value="{DynamicResource SoftBlueBrush}"/><Setter TargetName="ConversationCard" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateDot" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AttachmentTemplate" DataType="{x:Type domain:ChatAttachment}">
            <Button Click="Attachment_Click" PreviewMouseRightButtonDown="PreserveSelectionOnRightClick"
                    Height="Auto" MinHeight="0" FontWeight="Normal"
                    PreviewMouseLeftButtonDown="Attachment_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Attachment_PreviewMouseMove"
                    Padding="0" Margin="0,7,0,0" HorizontalContentAlignment="Stretch"
                    BorderThickness="0" Background="Transparent">

                <Button.ContextMenu><ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}" Opened="FileContextMenu_Opened">
<MenuItem Tag="open" Click="AttachmentOpenMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-open}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="copy" Click="AttachmentCopyMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-copy}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="locate" Click="AttachmentLocateMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-folder}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="save" Click="AttachmentSaveAsMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-download}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="info" Click="AttachmentInfoMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-details}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="pause" Click="AttachmentPause_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-pause}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="resume" Click="AttachmentResume_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-play}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="retry" Click="RetryTransfer_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-play}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<Separator Tag="active" Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
<MenuItem Tag="cancel" Click="AttachmentCancel_Click" Style="{StaticResource BlueLinkMenuItemStyle}" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-cancel}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<MenuItem Tag="failure" Click="TransferFailure_Click" Style="{StaticResource BlueLinkMenuItemStyle}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-alert}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
<Separator Tag="terminal" Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
<MenuItem Tag="delete" Click="AttachmentDeleteMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-trash}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
</ContextMenu></Button.ContextMenu>
                <Border x:Name="AttachmentBorder" BorderBrush="{DynamicResource BlueBrush}" BorderThickness="1" ClipToBounds="True">
                    <Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="14,14,14,4"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Outgoing, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{DynamicResource PanelEAF1FFBrush}"/><Setter Property="CornerRadius" Value="14,14,4,14"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid>
                        <Image x:Name="Thumbnail" Source="{Binding Converter={StaticResource AttachmentThumbnailConverter}}"
                               MaxWidth="240" MaxHeight="144" Stretch="None" HorizontalAlignment="Center" SizeChanged="Thumbnail_SizeChanged"
                               SnapsToDevicePixels="True" Visibility="Collapsed" ToolTip="{Binding FileName}"/>
                        <Grid x:Name="FileCard" Margin="10" Width="362" Height="50">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
                                <Image Source="{Binding FileIcon, Converter={StaticResource FileTypeIconConverter}}" RenderOptions.BitmapScalingMode="HighQuality" Width="24" Height="24"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource InkBrush}" FontWeight="Medium" FontSize="{StaticResource ClientFont13}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <TextBlock x:Name="FileSummary" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text><MultiBinding Converter="{StaticResource AttachmentSummary}"><Binding/><Binding Path="DataContext.Outgoing" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/></MultiBinding></TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Grid x:Name="FileProgress" Grid.Column="2" Width="40" Height="40" VerticalAlignment="Center" Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding ProgressText}">
                                <Ellipse Width="32" Height="32" Stroke="{DynamicResource PanelE4E9F2Brush}" StrokeThickness="4"/>
                                <ui:ProgressRing Width="36" Height="36" IsIndeterminate="False" Progress="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource BlueBrush}" Background="{DynamicResource PanelE4E9F2Brush}"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" FontSize="9" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Image x:Name="PausedReceiveIndicator" Grid.Column="2" Source="/BlueLink;component/Assets/Figma/paused-receive.png" Width="40" Height="40" Visibility="Collapsed" ToolTip="{Binding StateText}"/>
                        </Grid>
                        <Border x:Name="ImageProgress" Width="40" Height="40" Background="#8C0A1A29" CornerRadius="20" Visibility="Collapsed" ToolTip="{Binding ProgressText}">
                            <Grid><Ellipse Width="30" Height="30" Stroke="#55FFFFFF" StrokeThickness="3"/><ui:ProgressRing Width="34" Height="34" IsIndeterminate="False" Progress="{Binding ProgressPercent, Mode=OneWay}" Foreground="White" Background="#55FFFFFF"/><TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Border>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding IsImage}" Value="True"/><Condition Binding="{Binding DataContext.Settings.ShowImageThumbnails, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="Thumbnail" Property="Visibility" Value="Visible"/><Setter TargetName="FileCard" Property="Visibility" Value="Collapsed"/><Setter TargetName="AttachmentBorder" Property="BorderThickness" Value="0"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=Thumbnail}" Value="Visible"/><Condition Binding="{Binding ShowProgress}" Value="True"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="ImageProgress" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="Thumbnail" Property="Visibility" Value="Collapsed"/><Setter TargetName="FileCard" Property="Visibility" Value="Visible"/><Setter TargetName="ImageProgress" Property="Visibility" Value="Collapsed"/><Setter TargetName="AttachmentBorder" Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="RemotePaused">
                    <Setter TargetName="PausedReceiveIndicator" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Paused"/><Condition Binding="{Binding DataContext.Outgoing, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="PausedReceiveIndicator" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type domain:ChatItem}">
            <StackPanel>
                <Border Background="{DynamicResource PanelEDF1F7Brush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,8,0,10">
                    <Border.Visibility><MultiBinding Converter="{StaticResource MessageTimeGapConverter}"><Binding/><Binding RelativeSource="{RelativeSource PreviousData}"/></MultiBinding></Border.Visibility>
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                </Border>
            <Grid x:Name="MessageContextHost" Margin="8,8,0,10" PreviewMouseRightButtonDown="PreserveSelectionOnRightClick">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.ContextMenu><ContextMenu Style="{StaticResource BlueLinkContextMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{loc:Text '复制文本'}" Click="MessageCopyMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}" Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-copy}" Width="18" Height="18"/></MenuItem.Icon></MenuItem><Separator Style="{StaticResource BlueLinkMenuSeparatorStyle}"/>
                    <MenuItem Header="{loc:Text '删除本机记录'}" Click="MessageDeleteMenu_Click" Style="{StaticResource BlueLinkMenuItemStyle}" CommandParameter="danger"><MenuItem.Icon><Image Source="{DynamicResource FigmaIcon-menu-trash}" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                </ContextMenu></Grid.ContextMenu>
                <Border x:Name="Avatar" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SoftBlueBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Image Source="{Binding DataContext.ActivePeerIcon, RelativeSource={RelativeSource AncestorType=Window}}" Width="18" Height="18"/>
                </Border>
                <Border x:Name="Bubble" Grid.Column="1" HorizontalAlignment="Left" MaxWidth="520" MinWidth="64" Background="{DynamicResource SurfaceBrush}" CornerRadius="14,14,14,4" Padding="12,10">
                    <StackPanel>
                        <ui:TextBox x:Name="MessageText" SelectionChanged="MessageText_SelectionChanged" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="{StaticResource ClientFont13}" Foreground="{DynamicResource InkBrush}"
                                    IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False" AcceptsReturn="True" Cursor="IBeam"
                                    MinHeight="0" MinWidth="0" Padding="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Top"
                                    ClearButtonEnabled="False" FocusVisualStyle="{x:Null}"
                                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                    ContextMenu="{Binding ContextMenu, ElementName=MessageContextHost}" Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBox.Resources>
                                <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            </ui:TextBox.Resources>
                        </ui:TextBox>
                        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentTemplate}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MessageMeta" Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Visibility="Collapsed">
                    <InlineUIContainer BaselineAlignment="Center"><Image x:Name="MessageStatusIcon" Width="16" Height="16" Margin="0,0,4,0" Visibility="Collapsed"/></InlineUIContainer><Run Text="{Binding StatusText, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outgoing}" Value="True">
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/><Setter TargetName="Bubble" Property="Grid.Column" Value="0"/><Setter TargetName="Bubble" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource BlueBrush}"/><Setter TargetName="Bubble" Property="CornerRadius" Value="14,14,4,14"/>
                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter TargetName="MessageMeta" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasText}" Value="False"><Setter TargetName="Bubble" Property="Padding" Value="0"/><Setter TargetName="Bubble" Property="Background" Value="Transparent"/><Setter TargetName="MessageMeta" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:MessageStatus.LocalQueued}"><Setter TargetName="MessageStatusIcon" Property="Source" Value="{DynamicResource FigmaIcon-message-waiting}"/><Setter TargetName="MessageStatusIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:MessageStatus.Sending}"><Setter TargetName="MessageMeta" Property="Foreground" Value="{DynamicResource BlueBrush}"/><Setter TargetName="MessageStatusIcon" Property="Source" Value="{DynamicResource FigmaIcon-message-sending}"/><Setter TargetName="MessageStatusIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:MessageStatus.Failed}"><Setter TargetName="MessageMeta" Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter TargetName="MessageStatusIcon" Property="Source" Value="{DynamicResource FigmaIcon-message-failed}"/><Setter TargetName="MessageStatusIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:MessageStatus.Delivered}"><Setter TargetName="MessageStatusIcon" Property="Source" Value="{DynamicResource FigmaIcon-message-delivered}"/><Setter TargetName="MessageStatusIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:MessageStatus.Read}"><Setter TargetName="MessageMeta" Property="Foreground" Value="{DynamicResource BlueBrush}"/><Setter TargetName="MessageStatusIcon" Property="Source" Value="{DynamicResource FigmaIcon-message-read}"/><Setter TargetName="MessageStatusIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ChatItemKind.System}">
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/><Setter TargetName="Bubble" Property="Grid.Column" Value="0"/><Setter TargetName="Bubble" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PanelF8FAFDBrush}"/><Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter TargetName="Bubble" Property="BorderThickness" Value="1"/><Setter TargetName="Bubble" Property="CornerRadius" Value="16"/><Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter TargetName="MessageText" Property="FontSize" Value="12"/><Setter TargetName="MessageMeta" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar ButtonsForeground="{DynamicResource InkBrush}" x:Name="HomeTitleBar" Height="52" Padding="5,0" Title="" Background="{DynamicResource SurfaceBrush}" ShowMinimize="True" ShowMaximize="True" ShowClose="True">
            <ui:TitleBar.Resources>
                <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                    <Setter Property="Width" Value="50"/>
                    <Setter Property="Height" Value="52"/>
                </Style>
            </ui:TitleBar.Resources>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <Image Width="42" Height="42" Source="/BlueLink;component/Assets/bluelink-logo.png"/>
