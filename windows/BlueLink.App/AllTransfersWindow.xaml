<Window x:Class="BlueLink.AllTransfersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:BlueLink.Domain"
        Title="全部文件传输" Width="900" Height="650" MinWidth="720" MinHeight="500"
        Icon="/BlueLink;component/Assets/bluelink.ico"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="全部文件传输" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="按设备保存传输结果；完成状态表示整文件校验和落盘均成功。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="清除传输记录" Click="Clear_Click" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="FilterBox" Width="150" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="失败"/>
            </ComboBox>
        </StackPanel>
        <ListBox x:Name="TransferList" Grid.Row="2" ItemsSource="{Binding AllTransfers}" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><StaticResource ResourceKey="TransparentListItemStyle"/></ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#EAF1FF" CornerRadius="12" Padding="13,8" Margin="0,8,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="设备" Foreground="{StaticResource MutedBrush}" Margin="9,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=  · {0} 项}" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate><DataTemplate DataType="{x:Type domain:TransferItem}">
                <Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="#EAF1FF" CornerRadius="12"><TextBlock Text="▣" FontSize="20" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PeerId}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,7,0,5"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Direction}" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                            <Button Content="暂停" Click="Pause_Click" Margin="0,6,0,0" Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="继续" Click="Resume_Click" Margin="0,6,0,0" Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="取消" Click="Cancel_Click" Margin="0,6,0,0" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="重试" Click="Retry_Click" Margin="0,6,0,0" Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="定位" Click="Locate_Click" Margin="0,6,0,0" IsEnabled="{Binding CanLocate}"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
